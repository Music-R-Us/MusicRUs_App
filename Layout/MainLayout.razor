@inherits LayoutComponentBase

@inject MusicRUs.Services.AuthSessionService AuthSession
@inject IJSRuntime JS
@implements IDisposable
@inject MusicRUs.Services.ProfileColorService ProfileColors
@inject MusicRUs.Services.ToastService ToastService

<Toast />
<div class="min-h-screen bg-linear-to-br from-coffee-bean-950 via-coffee-bean-900 to-fiery-terracotta-950 text-porcelain-50 [html[data-theme=light]_&]:from-porcelain-50 [html[data-theme=light]_&]:via-porcelain-100 [html[data-theme=light]_&]:to-porcelain-50">
    <div class="flex min-h-screen w-full flex-col lg:flex-row">
        <aside class="border-b border-fiery-terracotta-700/40 bg-linear-to-r from-fiery-terracotta-950 to-fiery-terracotta-900 px-6 py-5 [html[data-theme=light]_&]:from-fiery-terracotta-900 [html[data-theme=light]_&]:to-fiery-terracotta-800 lg:flex lg:w-72 lg:flex-col lg:border-b-0 lg:border-r-0 lg:px-5">        
            <div class="mb-6 flex items-center gap-3">
                <a href="/">
                    <img src="/favicon.png" alt="Music-R-Us logo" class="h-10 w-10 rounded-full bg-granite-300 object-cover" />
                </a>
                <a href="/" class="text-lg font-semibold text-porcelain-50">Music-R-Us</a>

            </div>

            <Navbar />
        </aside>
        <main class="flex-1">
                <header class="flex items-center justify-between bg-linear-to-r from-fiery-terracotta-900 to-fiery-terracotta-950 px-6 py-4 [html[data-theme=light]_&]:from-fiery-terracotta-800 [html[data-theme=light]_&]:to-fiery-terracotta-900">             
                @if (AuthSession.CurrentUser is not null)
                {
                    <a href="@($"/profile/{AuthSession.CurrentUser.UserId}")" style="@($"background-color: {headerColor}; color: {MusicRUs.Services.ProfileColorService.TextColor(headerColor)};")" class="inline-flex items-center gap-3 rounded-full border border-granite-400/30 px-2 py-1 pr-4 transition">
                        @if (!string.IsNullOrWhiteSpace(HeaderAvatarUrl))
                        {
                            <img src="@HeaderAvatarUrl" alt="@HeaderDisplayName avatar" class="h-9 w-9 rounded-full bg-granite-300 object-cover" />
                        }
                        else
                        {
                            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-granite-300 text-sm font-semibold uppercase text-coffee-bean-950">
                                @HeaderAvatarInitial
                            </span>
                        }
                        <span class="grid text-left leading-tight">
                            <span class="text-x1 font-semibold text-porcelain-50">Profile</span>
                            <span class="text-x1 font-semibold">@HeaderDisplayName</span>
                        </span>
                    </a>
                }
                else
                {
                    <a href="/loginpick" class="rounded-full border border-granite-400/30 bg-granite-500/80 px-2 py-1 text-[0.7rem] font-medium uppercase tracking-[0.2em] text-pine-teal-300 transition hover:bg-granite-500">
                        Login/Signup
                    </a>
                }

                <div class="flex items-center gap-3">
                    <a class="text-sm font-medium text-granite-300 transition hover:text-porcelain-50"
                    href="/about"
                    rel="noreferrer">
                        About the app
                    </a>

                    <button type="button"
                            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-granite-300 bg-coffee-bean-950 text-xl text-porcelain-50 transition hover:bg-coffee-bean-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50"
                            @onclick="ToggleThemeAsync"
                            aria-label="@(isLightMode ? "Switch to dark mode" : "Switch to light mode")"
                            title="@(isLightMode ? "Switch to dark mode" : "Switch to light mode")">
                        <span aria-hidden="true">@(isLightMode ? "☀" : "☾")</span>
                    </button>
                </div>

            </header>

            <article class="px-6 py-8 lg:px-10">
                @Body
            </article>  
        </main>

    </div>
    <div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-fiery-terracotta-400/30 bg-coffee-bean-50 px-4 py-3 text-sm text-coffee-bean-950 shadow-lg shadow-black/20">
        <div class="mx-auto flex max-w-7xl items-center gap-3">
            <span class="font-medium">An unhandled error has occurred.</span>
            <a href="." class="rounded-md bg-fiery-terracotta-600 px-3 py-1.5 font-medium text-porcelain-50 no-underline hover:bg-fiery-terracotta-500">Reload</a>
            <button class="ml-auto text-lg leading-none text-fiery-terracotta-900" type="button" aria-label="Dismiss">x</button>
        </div>
    </div>
</div>

@code {
    private ForumProfile? HeaderProfile;
    private bool isLightMode;
    private string headerColor = MusicRUs.Services.ProfileColorService.DefaultColor;

    // Subscribes to authentication and profile-color changes for the header.
    protected override void OnInitialized()
    {
        AuthSession.Changed += OnAuthSessionChanged;
        ProfileColors.Changed += OnProfileColorChanged;
    }

    // Loads the theme, session, and header after first render, then enables inactivity tracking.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("MusicRUsTheme.getTheme");

            isLightMode = theme == "light";
            StateHasChanged();

            await AuthSession.InitializeAsync();
            await LoadHeaderProfileAsync();

            await JS.InvokeVoidAsync("MusicRUsAuth.registerInactivityLogout", 30, "/loginpick");

            StateHasChanged();
        }
    }

    // Reloads header details and redraws the layout after authentication changes.
    private void OnAuthSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadHeaderProfileAsync();
            StateHasChanged();
        });
    }

    // Reloads the current user's saved header color and redraws the layout.
    private void OnProfileColorChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (AuthSession.CurrentUser is { UserId: > 0 } user)
            {
                headerColor = await ProfileColors.GetAsync(user.UserId);
            }
            StateHasChanged();
        });
    }

    // Switches the browser theme and displays the selected mode.
    private async Task ToggleThemeAsync()
    {
        var requestedTheme = isLightMode ? "dark" : "light";

        var appliedTheme = await JS.InvokeAsync<string>(
            "MusicRUsTheme.setTheme", 
            requestedTheme);

        isLightMode = appliedTheme == "light";
        ToastService.Show($"Switched to {(isLightMode ? "light" : "dark")} mode.");
    }

    // Loads the signed-in user's profile details for the navigation header.
    private async Task LoadHeaderProfileAsync()
    {
        if (AuthSession.CurrentUser is null || AuthSession.CurrentUser.UserId <= 0)
        {
            HeaderProfile = null;
            headerColor = MusicRUs.Services.ProfileColorService.DefaultColor;
            return;
        }

        var userId = AuthSession.CurrentUser.UserId;
        var profile = await AuthSession.GetForumProfileAsync(userId);
        var color = await ProfileColors.GetAsync(userId);
        if (AuthSession.CurrentUser?.UserId != userId) return;
        HeaderProfile = profile;
        headerColor = color;
    }

    private string HeaderDisplayName
    {
        get
        {
            if (IsMeaningfulProfileValue(HeaderProfile?.DisplayName))
            {
                return HeaderProfile!.DisplayName;
            }

            return AuthSession.CurrentUser?.DisplayName ?? "Profile";
        }
    }

    private string HeaderAvatarUrl
    {
        get
        {
            if (IsMeaningfulProfileValue(HeaderProfile?.AvatarUrl))
            {
                return HeaderProfile!.AvatarUrl;
            }

            return AuthSession.CurrentUser?.AvatarUrl ?? string.Empty;
        }
    }

    private string HeaderAvatarInitial => string.IsNullOrWhiteSpace(HeaderDisplayName)
        ? "P"
        : HeaderDisplayName[0].ToString().ToUpperInvariant();

    // Rejects blank values and the API's string placeholder for header details.
    private static bool IsMeaningfulProfileValue(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && !string.Equals(value.Trim(), "string", StringComparison.OrdinalIgnoreCase);
    }

    // Unsubscribes from authentication and profile-color events.
    public void Dispose()
    {
        AuthSession.Changed -= OnAuthSessionChanged;
        ProfileColors.Changed -= OnProfileColorChanged;
    }
}
