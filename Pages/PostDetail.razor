@page "/posts/{PostId}"
@using MusicRUs.Services
@layout MainLayout

@inject MusicRUs.Services.PostFeedService PostFeed
@inject MusicRUs.Services.AuthSessionService AuthSession
@inject MusicRUs.Services.ToastService ToastService
@inject MusicRUs.Services.MusicCatalogService MusicCatalog
@inject NavigationManager Navigation

<PageTitle>@(Post?.Title ?? "Post")</PageTitle>

@if (Post is null)
{
	<section class="rounded-4xl border border-granite-800/80 gradient-surface p-8 text-porcelain-50 backdrop-blur">
		<p class="text-sm font-semibold uppercase tracking-[0.3em] text-pine-teal-300">Posts</p>
		<h1 class="mt-3 text-4xl font-semibold tracking-tight">Post not found</h1>
		<p class="mt-4 text-porcelain-50/75">The post you selected no longer exists.</p>
		<button class="mt-6 rounded-full bg-pine-teal-400 px-5 py-3 text-sm font-semibold text-coffee-bean-950" type="button" @onclick="GoBack">Back to posts</button>
	</section>
}
else
{
	<section class="grid gap-6">
		<div class="rounded-4xl border border-granite-800/80 gradient-surface p-8 backdrop-blur">
			<div class="grid gap-3">
				<p class="text-sm font-semibold uppercase tracking-[0.3em] text-pine-teal-300">Post detail</p>
				<h1 class="text-4xl font-semibold tracking-tight text-porcelain-50 sm:text-5xl">@Post.Title</h1>
				<div class="flex flex-wrap items-center gap-2 text-sm text-porcelain-50/70">
					<span>•</span>
					<a href="@PostAuthorProfileUrl" class="inline-flex items-center gap-2 font-semibold text-pine-teal-200 underline-offset-4 transition hover:text-pine-teal-100 hover:underline">

					<img src="@PostAuthorAvatarUrl" alt="@PostAuthorDisplayName avatar" class="h-9 w-9 shrink-0 rounded-full bg-pine-teal-300 object-cover" />
					<span>@PostAuthorDisplayName</span>
					</a>
					<span>•</span>
					<span>@DisplayTime.Format(Post.CreatedAtUtc)</span>
					@if (IsOwnPost)
					{
						<button type="button"
							@onclick="DeletePostAsync"
							class="rounded-full border border-red-400/30 bg-red-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-red-100 transition hover:border-red-300 hover:bg-red-400/20">
							Delete post
						</button>
					}
				</div>
			</div>

			<div class="mt-6 grid gap-4 rounded-3xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
				<p class="text-base leading-7 text-porcelain-50/85">@Post.Body</p>
				<div class="flex flex-wrap gap-2 text-sm text-porcelain-50/70">
					@foreach (var tag in Post.Tags)
					{
						<span class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1">#@tag</span>
					}
				</div>
				@if (HasMusicSelection(Post))
				{
					<div class="grid gap-6 border-t border-granite-800 pt-4 sm:grid-cols-2">
						@if(!string.IsNullOrWhiteSpace(Post.Artist))
						{
							<div class="grid content-start gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
								<h2 class="text-xl font-semibold text-porcelain-50">Artist</h2>
								<div class="flex items-center gap-3 rounded-xl bg-coffee-bean-950/80 p-3">
									@if (!string.IsNullOrWhiteSpace(Post.ArtistImageUrl))
									{
										<a href="/music/artist/@Post.ArtistId">
											<img src="@Post.ArtistImageUrl" alt="" loading="lazy" class="h-14 w-14 shrink-0 rounded-full object-cover" />
										</a>
									}

									<a href="/music/artist/@Post.ArtistId" class="font-semibold text-porcelain-50">@Post.Artist</a>
								</div>
							</div>
						}
						@if (!string.IsNullOrWhiteSpace(Post.Album))
						{
							<div class="grid content-start gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
								<h2 class="text-xl font-semibold text-porcelain-50">Album</h2>
								<div class="flex items-center gap-3 rounded-xl bg-coffee-bean-950/80 p-3">
									@if (!string.IsNullOrWhiteSpace(Post.AlbumImageUrl))
									{
										<a href="/music/album/@Post.AlbumId">
											<img src="@Post.AlbumImageUrl" alt="" loading="lazy" class="h-14 w-14 shrink-0 rounded-lg object-cover" />
										</a>
									}
									<div>
										<a href="/music/album/@Post.AlbumId">
											<p class="font-semibold text-porcelain-50">@Post.Album</p>
											<p class="text-sm text-porcelain-50/70">@AlbumArtistName</p>	
										</a>

									</div>
								</div>
							</div>
						}
						@if (!string.IsNullOrWhiteSpace(Post.Song))
						{
							<div class="grid content-start gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
								<h2 class="text-xl font-semibold text-porcelain-50">Track</h2>
								<div class="flex items-center gap-3 rounded-xl bg-coffee-bean-950/80 p-3">
									<div>
										<p class="font-semibold text-porcelain-50">@Post.Song</p>
										<p class="text-sm text-porcelain-50/70">@Post.TrackArtistName</p>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>

		<div class="grid gap-4 rounded-4xl border border-granite-800/80 bg-coffee-bean-950/70 p-8 backdrop-blur">
            @if(AuthSession.CurrentUser is not null)
            {
                <div class="flex items-center justify-between gap-4">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-pine-teal-300">Comments</p>
                        <h2 class="mt-2 text-2xl font-semibold text-porcelain-50">Join the conversation</h2>
                    </div>
                    <p class="text-sm text-porcelain-50/60">@CommentPage.TotalCount replies</p>
                </div>

                <EditForm Model="CommentDraft" OnValidSubmit="AddCommentAsync" class="grid gap-4">
                    <InputText @bind-Value="CommentDraft.Body" placeholder="Write a comment..." class="w-full rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
                    <button class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50 transition hover:border-pine-teal-300 hover:text-pine-teal-200" type="submit">Send comment</button>
                </EditForm>
            }
			<div class="grid gap-3">
				@if (CommentPage.Comments.Count == 0)
				{
					<div class="rounded-3xl border border-granite-800/70 bg-coffee-bean-900/70 p-4 text-porcelain-50/70">
						No comments yet.
					</div>
				}
				else
				{
					@foreach (var comment in CommentPage.Comments)
					{
						<div class="rounded-3xl border border-granite-800/70 bg-coffee-bean-900/70 p-4">
							<div class="flex items-start justify-between gap-4 text-sm text-porcelain-50/60">
								<div class="flex min-w-0 items-center gap-3">
									@if (!string.IsNullOrWhiteSpace(GetCommentAuthorAvatarUrl(comment)))
									{
										<img src="@GetCommentAuthorAvatarUrl(comment)" alt="@GetCommentAuthor(comment) avatar" class="h-11 w-11 shrink-0 rounded-full bg-pine-teal-300 object-cover" />
									}
									else
									{
										<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-pine-teal-300 text-sm font-semibold uppercase text-coffee-bean-950">
											@GetCommentAuthorInitial(comment)
										</span>
									}
									<a href="@GetCommentAuthorProfileUrl(comment)" class="truncate font-medium text-porcelain-50 underline-offset-4 transition hover:text-pine-teal-200 hover:underline">@GetCommentAuthor(comment)</a>
								</div>
								<div class="flex shrink-0 items-center gap-2">
									<p>@DisplayTime.Format(comment.CreatedAtUtc)</p>
									@if (IsOwnComment(comment))
									{
										<button type="button"
											@onclick="() => DeleteCommentAsync(comment)"
											class="rounded-full border border-red-400/30 bg-red-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-red-100 transition hover:border-red-300 hover:bg-red-400/20">
											Delete
										</button>
									}
								</div>
							</div>
							<p class="mt-2 leading-7 text-porcelain-50/80">@comment.DisplayBody</p>
						</div>
					}
				}
			</div>

			@if (CommentPage.TotalPages > 1)
			{
				<div class="flex flex-wrap items-center justify-between gap-3 border-t border-granite-800 pt-4">
					<button class="rounded-full border border-granite-700 px-4 py-2 text-sm font-medium text-porcelain-50/80 transition enabled:hover:bg-granite-900 disabled:opacity-40" type="button" disabled="@(CommentPage.Page <= 1)" @onclick="PreviousCommentsPageAsync">Previous</button>
					<span class="text-sm text-porcelain-50/60">Page @CommentPage.Page of @CommentPage.TotalPages</span>
					<button class="rounded-full border border-granite-700 px-4 py-2 text-sm font-medium text-porcelain-50/80 transition enabled:hover:bg-granite-900 disabled:opacity-40" type="button" disabled="@(CommentPage.Page >= CommentPage.TotalPages)" @onclick="NextCommentsPageAsync">Next</button>
				</div>
			}
		</div>
	</section>
}

@code {
	[Parameter]
	public string PostId { get; set; } = string.Empty;

	private MusicRUs.Models.PostItem? Post;
	private readonly CommentDraftModel CommentDraft = new();

	private sealed class CommentDraftModel
	{
		public string Body { get; set; } = string.Empty;
	}
	private MusicRUs.Models.CommentPage CommentPage = MusicRUs.Models.CommentPage.Empty(1, CommentsPageSize);
	private Dictionary<int, MusicRUs.Models.ForumProfile> CommentProfiles = [];
	private Dictionary<int, MusicRUs.Models.UserSession> CommentUsers = [];
	private MusicRUs.Models.ForumProfile? PostAuthorProfile;
	private MusicRUs.Models.UserSession? PostAuthorUser;
	private string AlbumArtistName = string.Empty;
	private const int CommentsPageSize = 10;

	// Loads the routed post, its author, linked music details, and first comment page.
	protected override async Task OnParametersSetAsync()
	{
		await AuthSession.InitializeAsync();
		Post = await PostFeed.GetPostAsync(PostId);
		await LoadMusicDetailsAsync();
		PostAuthorProfile = Post?.UserId > 0
			? await AuthSession.GetForumProfileAsync(Post.UserId)
			: null;
		PostAuthorUser = Post?.UserId > 0
			? await AuthSession.GetUserAsync(Post.UserId)
			: null;
		await LoadCommentsAsync(1);
	}

	// Fills in linked music details used by the post's music card.
	private async Task LoadMusicDetailsAsync()
	{
		AlbumArtistName = string.Empty;
		var post = Post;
		if (post is null) return;

		if (post.ArtistId is > 0)
		{
			var artist = await MusicCatalog.GetArtistAsync(post.ArtistId.Value, AuthSession.CurrentUser);
			if (artist is not null)
			{
				post.Artist = artist.Name;
				post.ArtistImageUrl = artist.ImageUrl;
			}
		}
		if (post.AlbumId is > 0)
		{
			var album = await MusicCatalog.GetAlbumByIdAsync(post.AlbumId.Value, AuthSession.CurrentUser);
			if (album is not null)
			{
				if (string.IsNullOrWhiteSpace(post.Album)) post.Album = album.Title;
				if (string.IsNullOrWhiteSpace(post.AlbumImageUrl)) post.AlbumImageUrl = album.ImageUrl;
				AlbumArtistName = album.ArtistName;
			}
		}
		if (string.IsNullOrWhiteSpace(AlbumArtistName)) AlbumArtistName = post.Artist;
		if (post.TrackAlbumId is > 0)
		{
			var album = await MusicCatalog.GetAlbumByIdAsync(post.TrackAlbumId.Value, AuthSession.CurrentUser);
			if (album is not null)
			{
				if (string.IsNullOrWhiteSpace(post.TrackImageUrl)) post.TrackImageUrl = album.ImageUrl;
				if (string.IsNullOrWhiteSpace(post.TrackArtistName)) post.TrackArtistName = album.ArtistName;
			}
		}
		if (string.IsNullOrWhiteSpace(post.TrackImageUrl)) post.TrackImageUrl = post.AlbumImageUrl;
		if (string.IsNullOrWhiteSpace(post.TrackArtistName)) post.TrackArtistName = AlbumArtistName;
	}

	// Returns to the posts feed.
	private void GoBack() => Navigation.NavigateTo("/posts");

	// Submits the comment draft, clears it, and reloads the first comment page.
	private async Task AddCommentAsync()
	{
		if (Post is null || string.IsNullOrWhiteSpace(CommentDraft.Body))
		{
			return;
		}

		await PostFeed.AddCommentAsync(Post, AuthSession.CurrentUser, CommentDraft.Body);
		CommentDraft.Body = string.Empty;

        ToastService?.Show("Comment added successfully.");

		await LoadCommentsAsync(1);
	}

	// Deletes the current user's post and returns to the feed after success.
	private async Task DeletePostAsync()
	{
		if (Post is null || !IsOwnPost)
		{
			return;
		}

		if (await PostFeed.DeletePostAsync(Post, AuthSession.CurrentUser))
		{
            ToastService?.Show("Post deleted successfully.");

			Navigation.NavigateTo("/posts");
		}
	}

	// Deletes the current user's comment and reloads the current comment page.
	private async Task DeleteCommentAsync(MusicRUs.Models.CommentItem comment)
	{
		if (Post is null || !IsOwnComment(comment))
		{
			return;
		}

		if (await PostFeed.DeleteCommentAsync(Post, comment, AuthSession.CurrentUser))
		{
			ToastService?.Show("Comment deleted successfully.");

			await LoadCommentsAsync(CommentPage.Page);
		}
	}

	// Loads the requested comment page and its authors' profile details.
	private async Task LoadCommentsAsync(int page)
	{
		if (Post is null)
		{
			CommentPage = MusicRUs.Models.CommentPage.Empty(1, CommentsPageSize);
			return;
		}

		CommentPage = await PostFeed.GetCommentsAsync(Post, page, CommentsPageSize);
		await LoadCommentProfilesAsync();
	}

	// Loads author profiles for the visible comments.
	private async Task LoadCommentProfilesAsync()
	{
		CommentProfiles = [];
		CommentUsers = [];
		foreach (var userId in CommentPage.Comments.Select(comment => comment.UserId).Where(userId => userId > 0).Distinct())
		{
			var profile = await AuthSession.GetForumProfileAsync(userId);
			if (profile is not null)
			{
				CommentProfiles[userId] = profile;
			}

			var user = await AuthSession.GetUserAsync(userId);
			if (user is not null)
			{
				CommentUsers[userId] = user;
			}
		}
	}

	// Loads the previous comment page without going below page one.
	private async Task PreviousCommentsPageAsync()
	{
		await LoadCommentsAsync(Math.Max(1, CommentPage.Page - 1));
	}

	// Loads the next comment page without passing the last page.
	private async Task NextCommentsPageAsync()
	{
		await LoadCommentsAsync(Math.Min(CommentPage.TotalPages, CommentPage.Page + 1));
	}

	// Checks whether the post contains an artist, album, or song name.
	private static bool HasMusicSelection(MusicRUs.Models.PostItem post)
	{
		return !string.IsNullOrWhiteSpace(post.Artist)
			|| !string.IsNullOrWhiteSpace(post.Album)
			|| !string.IsNullOrWhiteSpace(post.Song);
	}

	private string PostAuthorDisplayName => !string.IsNullOrWhiteSpace(PostAuthorProfile?.DisplayName)
		? PostAuthorProfile.DisplayName
		: !string.IsNullOrWhiteSpace(PostAuthorUser?.Username) ? PostAuthorUser.Username : $"User {Post?.UserId ?? 0}";

	private string PostAuthorAvatarUrl => !string.IsNullOrWhiteSpace(PostAuthorProfile?.AvatarUrl)
		? PostAuthorProfile.AvatarUrl
		: PostAuthorUser?.AvatarUrl ?? string.Empty;

	private string PostAuthorProfileUrl => Post?.UserId > 0
		? $"/profile/{Post.UserId}"
		: "/posts";

	private bool IsOwnPost => Post is not null
		&& MusicRUs.Services.PostFeedService.IsOwnPost(Post, AuthSession.CurrentUser);

	// Checks comment ownership using the user's ID or matching username.
	private bool IsOwnComment(MusicRUs.Models.CommentItem comment)
	{
		return MusicRUs.Services.PostFeedService.IsOwnComment(comment, AuthSession.CurrentUser);
	}

	// Uses the author's profile name, username, or user-ID fallback.
	private string GetCommentAuthor(MusicRUs.Models.CommentItem comment)
	{
		var profile = GetCommentAuthorProfile(comment);
		if (!string.IsNullOrWhiteSpace(profile?.DisplayName))
		{
			return profile.DisplayName;
		}

		return comment.UserId > 0 && CommentUsers.TryGetValue(comment.UserId, out var user) && !string.IsNullOrWhiteSpace(user.Username)
			? user.Username
			: $"User {comment.UserId}";
	}

	// Returns the loaded profile for a comment's author when available.
	private MusicRUs.Models.ForumProfile? GetCommentAuthorProfile(MusicRUs.Models.CommentItem comment)
	{
		return comment.UserId > 0 && CommentProfiles.TryGetValue(comment.UserId, out var profile)
			? profile
			: null;
	}

	// Returns the comment author's profile avatar or an empty string.
	private string GetCommentAuthorAvatarUrl(MusicRUs.Models.CommentItem comment)
	{
		return GetCommentAuthorProfile(comment)?.AvatarUrl ?? string.Empty;
	}

	// Builds a one-letter avatar fallback from the comment author's name.
	private string GetCommentAuthorInitial(MusicRUs.Models.CommentItem comment)
	{
		var author = GetCommentAuthor(comment);
		return string.IsNullOrWhiteSpace(author)
			? "?"
			: author.Trim()[0].ToString().ToUpperInvariant();
	}

	// Builds the comment author's profile link or falls back to the feed.
	private static string GetCommentAuthorProfileUrl(MusicRUs.Models.CommentItem comment)
	{
		return comment.UserId > 0
			? $"/profile/{comment.UserId}"
			: "/posts";
	}
}
