@page "/friendships"
@layout MainLayout
@using MusicRUs.Services
@inject AuthSessionService AuthSession
@inject FriendshipService FriendshipApi
@inject UserBlockService UserBlocks
@inject ToastService ToastService

<PageTitle>Friendships – MusicRUs</PageTitle>

<section class="grid gap-6">
    <div class="relative overflow-hidden rounded-3xl border border-fiery-terracotta-800 bg-linear-to-br from-fiery-terracotta-900/95 to-fiery-terracotta-700/85 p-8 shadow-xl lg:p-12">
        <div class="grid gap-2">
            <p class="text-xl font-semibold text-porcelain-50">Friendships</p>
            <h1 class="text-4xl font-semibold text-porcelain-50 sm:text-5xl">Your friends</h1>
            <p class="text-xl text-porcelain-50">Find other collectors, answer requests and keep track of your friends.</p>
        </div>
    </div>

    @if (user is null)
    {
        <SignInPrompt Message="Sign in to see your friends." />
    }
    else
    {
        @if (error is not null)
        {
            <p role="alert" class="rounded-xl border border-fiery-terracotta-400/40 p-4 text-porcelain-50">@error</p>
        }

        @* Search for other users and send friend requests *@
        <div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
            <h2 class="text-xl font-semibold text-porcelain-50">Find users</h2>
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="flex flex-col gap-3 sm:flex-row">
                <div class="grid flex-1 gap-2">
                    <label for="friend-search" class="text-sm text-porcelain-50">Username</label>
                    <input id="friend-search" @bind="query" @bind:event="oninput" placeholder="Search users…" maxlength="100" disabled="@busy"
                           class="w-full rounded-xl border border-granite-700 bg-coffee-bean-950 px-4 py-3 text-porcelain-50" />
                </div>
                <button type="submit" disabled="@(busy || query.Trim().Length < 2)"
                        class="self-end rounded-xl bg-fiery-terracotta-700 px-6 py-3 font-semibold text-porcelain-50 disabled:opacity-50">Search</button>
            </form>

            @if (searched && results.Count == 0)
            {
                <p class="text-porcelain-50/60">No users found.</p>
            }
            @foreach (var result in results)
            {
                var relation = RelationTo(result.Id);
                <div class="flex items-center justify-between gap-3 rounded-xl bg-coffee-bean-950/80 px-4 py-3">
                    <a href="/profile/@result.Id" class="font-semibold text-porcelain-50">@result.Username</a>
                    <div class="flex flex-wrap items-center justify-end gap-2">
                        <button type="button" disabled="@(busy || blocks is null)" @onclick="() => ToggleBlockAsync(result)"
                                class="rounded-full border border-granite-300/60 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-granite-300 hover:bg-granite-800 disabled:opacity-60">@(HasBlocked(result.Id) ? "Unblock" : "Block")</button>
                    @if (relation is null)
                    {
                        <button type="button" disabled="@(busy || blocks is null || IsBlocked(result.Id))" @onclick="() => SendRequestAsync(result)"
                                class="rounded-full bg-fiery-terracotta-500/90 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-fiery-terracotta-500/70 disabled:opacity-60">Add friend</button>
                    }
                    else
                    {
                        <span class="text-sm text-porcelain-50/60">@relation</span>
                    }
                    </div>
                </div>
            }
        </div>

        @* Requests other users have sent to me *@
        <div class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
            <h2 class="text-xl font-semibold text-porcelain-50">Friend requests</h2>
            @if (!Incoming.Any())
            {
                <p class="text-porcelain-50/60">No new friend requests.</p>
            }
            @foreach (var request in Incoming)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-coffee-bean-950/80 px-4 py-3">
                    <a href="/profile/@OtherId(request)" class="font-semibold text-porcelain-50">@OtherName(request)</a>
                    <div class="flex gap-2">
                        <button type="button" disabled="@busy" @onclick="() => AcceptAsync(request)"
                                class="rounded-full bg-pine-teal-600 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-pine-teal-500 disabled:opacity-60">Accept</button>
                        <button type="button" disabled="@busy" @onclick="() => RejectAsync(request)"
                                class="rounded-full border border-granite-300/60 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-granite-300 hover:bg-granite-800 disabled:opacity-60">Reject</button>
                    </div>
                </div>
            }
        </div>

        @* Requests I have sent that are still waiting *@
        @if (Outgoing.Any())
        {
            <div class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
                <h2 class="text-xl font-semibold text-porcelain-50">Sent requests</h2>
                @foreach (var request in Outgoing)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-coffee-bean-950/80 px-4 py-3">
                        <a href="/profile/@OtherId(request)" class="font-semibold text-porcelain-50">@OtherName(request)</a>
                        <button type="button" disabled="@busy" @onclick='() => RemoveAsync(request, "Friend request cancelled")'
                                class="rounded-full border border-granite-300/60 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-granite-300 hover:bg-granite-800 disabled:opacity-60">Cancel</button>
                    </div>
                }
            </div>
        }

        @* Accepted friendships *@
        <div class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
            <h2 class="text-xl font-semibold text-porcelain-50">Friends (@Friends.Count())</h2>
            @if (!Friends.Any())
            {
                <p class="text-porcelain-50/60">You have no friends yet. Search for users above.</p>
            }
            @foreach (var friend in Friends)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-coffee-bean-950/80 px-4 py-3">
                    <a href="/profile/@OtherId(friend)" class="font-semibold text-porcelain-50">@OtherName(friend)</a>
                    <button type="button" disabled="@busy" @onclick='() => RemoveAsync(friend, "Friend removed")'
                            class="rounded-full border border-granite-300/60 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-granite-300 hover:bg-granite-800 disabled:opacity-60">Remove</button>
                </div>
            }
        </div>
    }
</section>

@code {
    private UserSession? user;
    private List<FriendshipItem> friendships = [];
    private List<FriendshipUser> results = [];
    private List<UserBlock>? blocks;
    private string query = string.Empty;
    private bool searched;
    private bool busy;
    private string? error;

    private IEnumerable<FriendshipItem> Incoming => friendships.Where(f => IsStatus(f, "Pending") && f.AddresseeId == user?.UserId);
    private IEnumerable<FriendshipItem> Outgoing => friendships.Where(f => IsStatus(f, "Pending") && f.RequesterId == user?.UserId);
    private IEnumerable<FriendshipItem> Friends => friendships.Where(f => IsStatus(f, "Accepted"));

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        user = AuthSession.CurrentUser is { UserId: > 0 } current ? current : null;
        if (user is not null)
        {
            await LoadAsync();
        }
    }

    // Loads all friendships (pending and accepted) for the logged-in user
    private async Task LoadAsync()
    {
        var list = await FriendshipApi.GetAllAsync(user!);
        error = list is null ? "Could not load your friendships. Please try again." : null;
        friendships = list ?? [];
        blocks = await UserBlocks.GetAsync(user!);
        if (blocks is null)
            error = "Could not load your blocked users. Please try again.";
    }

    private bool HasBlocked(int userId) => blocks?.Any(b => b.BlockerId == user!.UserId && b.BlockedId == userId) == true;

    private bool IsBlocked(int userId) => blocks?.Any(b =>
        (b.BlockerId == user!.UserId && b.BlockedId == userId) ||
        (b.BlockerId == userId && b.BlockedId == user!.UserId)) == true;

    private Task ToggleBlockAsync(FriendshipUser other)
    {
        if (blocks is null) return Task.CompletedTask;
        var wasBlocked = HasBlocked(other.Id);
        return RunAsync(
            () => wasBlocked ? UserBlocks.UnblockAsync(user!, other.Id) : UserBlocks.BlockAsync(user!, other.Id),
            wasBlocked ? "User unblocked" : "User blocked",
            "Unable to update block. Please try again.");
    }

    private async Task SearchAsync()
    {
        if (busy || query.Trim().Length < 2) return;
        busy = true;
        try
        {
            results = (await FriendshipApi.SearchUsersAsync(user!, query))
                .Where(u => u.Id != user!.UserId)
                .ToList();
            searched = true;
        }
        finally { busy = false; }
    }

    // Shows how I am already connected to a user in the search results, or null if not at all
    private string? RelationTo(int otherUserId)
    {
        var f = friendships.FirstOrDefault(f => f.RequesterId == otherUserId || f.AddresseeId == otherUserId);
        if (f is null) return null;
        if (IsStatus(f, "Accepted")) return "Friends";
        return f.RequesterId == user!.UserId ? "Request sent" : "Wants to be your friend";
    }

    private int OtherId(FriendshipItem f) => f.RequesterId == user!.UserId ? f.AddresseeId : f.RequesterId;

    private string OtherName(FriendshipItem f) => f.OtherUser(user!.UserId).Username;
    private static bool IsStatus(FriendshipItem f, string status) => string.Equals(f.Status, status, StringComparison.OrdinalIgnoreCase);

    // Runs an action, reloads the list and shows a toast or an error
    private async Task RunAsync(Func<Task<bool>> action, string successMessage, string errorMessage)
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            if (await action())
            {
                ToastService?.Show(successMessage);
                await LoadAsync();
            }
            else
            {
                error = errorMessage;
            }
        }
        finally { busy = false; }
    }

    private Task SendRequestAsync(FriendshipUser other) =>
        RunAsync(() => FriendshipApi.SendRequestAsync(user!, other.Id), $"Friend request sent to {other.Username}", "Could not send the friend request.");

    private Task AcceptAsync(FriendshipItem f) =>
        RunAsync(() => FriendshipApi.AcceptAsync(user!, f.Id), "Friend request accepted", "Could not accept the friend request.");

    private Task RejectAsync(FriendshipItem f) =>
        RunAsync(() => FriendshipApi.RejectAsync(user!, f.Id), "Friend request rejected", "Could not reject the friend request.");

    private Task RemoveAsync(FriendshipItem f, string successMessage) =>
        RunAsync(() => FriendshipApi.RemoveAsync(user!, f), successMessage, "Could not remove the friendship.");
}
