@page "/loginpick"

@layout MainLayout

@using System.ComponentModel.DataAnnotations
@inject MusicRUs.Services.ToastService ToastService
@inject MusicRUs.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(currentMode == AuthMode.Login ? "Login" : "Signup") - MusicRUs</PageTitle>

<section class="gradient-surface mx-auto w-full max-w-3xl p-10">
	<div class="grid gap-8">
		<div class="text-center">
			<h1 class="text-4xl font-semibold tracking-tight text-porcelain-50 sm:text-5xl">
				@(currentMode == AuthMode.Login ? "Login" : "Signup")
			</h1>
			<p class="mt-3 text-base leading-7 text-porcelain-50/80 sm:text-lg">
				@(currentMode == AuthMode.Login
					? "Sign in with your username and password."
					: "Create an account with a few extra details.")
			</p>
		</div>

		@if (!string.IsNullOrWhiteSpace(formMessage))
		{
			<div class="rounded-2xl border border-fiery-terracotta-300/50 bg-fiery-terracotta-950/80 p-4 text-sm font-medium text-porcelain-50">
				@formMessage
			</div>
		}

		<div class="grid grid-cols-2 gap-4">
			<button type="button"
				class="rounded-2xl border px-5 py-4 text-lg font-semibold transition @(currentMode == AuthMode.Login ? "border-fiery-terracotta-300 bg-fiery-terracotta-600 text-porcelain-50" : "border-granite-800/80 bg-fiery-terracotta-900/80 text-porcelain-50/80 hover:text-porcelain-50")"
				@onclick="ShowLogin">
				Login
			</button>
			<button type="button"
				class="rounded-2xl border px-5 py-4 text-lg font-semibold transition @(currentMode == AuthMode.Signup ? "border-fiery-terracotta-300 bg-fiery-terracotta-600 text-porcelain-50" : "border-granite-800/80 bg-fiery-terracotta-900/80 text-porcelain-50/80 hover:text-porcelain-50")"
				@onclick="ShowSignup">
				Signup
			</button>
		</div>

		@if (currentMode == AuthMode.Login)
		{
			<EditForm Model="loginModel" OnValidSubmit="HandleLoginSubmit">
				<DataAnnotationsValidator />
				<ValidationSummary class="text-sm text-fiery-terracotta-200" />
				<div class="grid gap-5">
					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="login-username">Username</label>
						<InputText id="login-username" name="login-username" autocomplete="username" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="loginModel.Username" />
					</div>

					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="login-password">Password</label>
						<InputText id="login-password" name="login-password" autocomplete="current-password" type="@(showLoginPassword ? "text" : "password")" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="loginModel.Password" />
						<button type="button" aria-controls="login-password"
						        aria-label="@(showLoginPassword ? "Hide password" : "Show password")"
						        class="min-h-11 justify-self-start rounded-lg px-3 py-2 text-sm font-semibold text-porcelain-50 underline underline-offset-4 hover:bg-fiery-terracotta-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50"
						        @onclick="() => showLoginPassword = !showLoginPassword">
						    @(showLoginPassword ? "Hide password" : "Show password")
						</button>
					</div>

					<button type="submit" disabled="@isSubmitting" class="rounded-2xl bg-fiery-terracotta-600 px-5 py-3 text-lg font-semibold text-porcelain-50 transition hover:bg-fiery-terracotta-700 disabled:cursor-not-allowed disabled:opacity-60">
						@(isSubmitting ? "Logging in..." : "Log in")
					</button>
				</div>
			</EditForm>
		}
		else if (currentMode == AuthMode.Signup)
		{
			<EditForm Model="signupModel" OnValidSubmit="HandleSignupSubmit">
				<DataAnnotationsValidator />
				<ValidationSummary class="text-sm text-fiery-terracotta-200" />
				<div class="grid gap-5">
					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="signup-name">Username</label>
						<InputText id="signup-name" name="signup-name" autocomplete="username" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="signupModel.Username" />
					</div>

					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="signup-email">Email</label>
						<InputText id="signup-email" type="email" name="signup-email" autocomplete="email" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="signupModel.Email" />
					</div>

					<div class="grid gap-2 sm:grid-cols-2">
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="signup-password">Password</label>
							<InputText id="signup-password" name="signup-password" autocomplete="new-password" type="@(showSignupPassword ? "text" : "password")" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="signupModel.Password" />
							<button type="button" aria-controls="signup-password"
							        aria-label="@(showSignupPassword ? "Hide password" : "Show password")"
							        class="min-h-11 justify-self-start rounded-lg px-3 py-2 text-sm font-semibold text-porcelain-50 underline underline-offset-4 hover:bg-fiery-terracotta-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50"
							        @onclick="() => showSignupPassword = !showSignupPassword">
							    @(showSignupPassword ? "Hide password" : "Show password")
							</button>
						</div>
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="signup-confirm">Confirm password</label>
							<InputText id="signup-confirm" name="signup-confirm" autocomplete="new-password" type="@(showConfirmPassword ? "text" : "password")" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="signupModel.ConfirmPassword" />
							<button type="button" aria-controls="signup-confirm"
							        aria-label="@(showConfirmPassword ? "Hide confirm password" : "Show confirm password")"
							        class="min-h-11 justify-self-start rounded-lg px-3 py-2 text-sm font-semibold text-porcelain-50 underline underline-offset-4 hover:bg-fiery-terracotta-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50"
							        @onclick="() => showConfirmPassword = !showConfirmPassword">
							    @(showConfirmPassword ? "Hide password" : "Show password")
							</button>
						</div>
					</div>

					<button type="submit" disabled="@isSubmitting" class="rounded-2xl bg-fiery-terracotta-600 px-5 py-3 text-lg font-semibold text-porcelain-50 transition hover:bg-fiery-terracotta-700 disabled:cursor-not-allowed disabled:opacity-60">
						@(isSubmitting ? "Creating account..." : "Create account")
					</button>
				</div>
			</EditForm>
		}

		<div class="grid gap-4 border-t border-granite-800/80 pt-6">
			<div class="flex items-center gap-4 text-sm font-medium text-porcelain-50/60">
				<span class="h-px flex-1 bg-granite-800"></span>
				@if (currentMode == AuthMode.Login)
				{
					<span>Or log in with</span>
				}
				else if (currentMode == AuthMode.Signup)
				{
					<span>Or sign up with</span>
				}
				<span class="h-px flex-1 bg-granite-800"></span>
			</div>
			<div id="google-btn" class="flex min-h-11 justify-center"></div>
		</div>
	</div>
</section>

@code {
	private AuthMode currentMode = AuthMode.Login;
	private bool isSubmitting;
	private bool showLoginPassword;
	private bool showSignupPassword;
	private bool showConfirmPassword;
	private AuthMode? renderedGoogleMode;
	private string formMessage = string.Empty;
	private DotNetObjectReference<LoginPick>? dotNetReference;

	private readonly LoginModel loginModel = new();
	private readonly SignupModel signupModel = new();

	// Renders the Google sign-in button when the login or signup mode changes.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (renderedGoogleMode == currentMode)
		{
			return;
		}

		renderedGoogleMode = currentMode;
		dotNetReference ??= DotNetObjectReference.Create(this);
		await JS.InvokeVoidAsync(
			"initGoogleSignIn", 
			dotNetReference,
			currentMode == AuthMode.Login 
			? "continue_with"
			: "signup_with");
	}

	private void ResetPasswordVisibility()
	{
		showLoginPassword = false;
		showSignupPassword = false;
		showConfirmPassword = false;
	}

	// Switches to the login form and clears the previous message.
	private void ShowLogin()
	{
		formMessage = string.Empty;
		currentMode = AuthMode.Login;
		ResetPasswordVisibility();
	}

	// Switches to the signup form and clears the previous message.
	private void ShowSignup()
	{
		formMessage = string.Empty;
		currentMode = AuthMode.Signup;
		ResetPasswordVisibility();
	}

	// Signs in with the entered credentials and redirects or shows the returned error.
	private async Task HandleLoginSubmit()
	{
		isSubmitting = true;
		formMessage = string.Empty;

		var result = await AuthSession.LoginAsync(loginModel.Username, loginModel.Password);
		isSubmitting = false;

		if (!result.IsSuccess || result.User is null)
		{
			formMessage = result.ErrorMessage ?? "Login failed.";
			return;
		}

		ToastService?.Show("Logged in successfully");

		Navigation.NavigateTo(await GetPostLoginUrlAsync(result.User));
	}

	// Creates an account from the form and redirects or shows the returned error.
	private async Task HandleSignupSubmit()
	{
		isSubmitting = true;
		formMessage = string.Empty;

		var result = await AuthSession.SignupAsync(new SignupRequest
		{
			Username = signupModel.Username,
			Email = signupModel.Email,
			Password = signupModel.Password,
		});
		isSubmitting = false;

		if (!result.IsSuccess || result.User is null)
		{
			formMessage = result.ErrorMessage ?? "Signup failed.";
			return;
		}

		ToastService?.Show("Account created successfully");

		Navigation.NavigateTo(await GetPostLoginUrlAsync(result.User));
	}

	[JSInvokable]
	// Receives Google's token from JavaScript and completes login or displays an error.
	public async Task OnGoogleToken(string idToken)
	{
		isSubmitting = true;
		formMessage = string.Empty;
		await InvokeAsync(StateHasChanged);

		var result = await AuthSession.GoogleLoginAsync(idToken);
		isSubmitting = false;

		if (!result.IsSuccess || result.User is null)
		{
			formMessage = result.ErrorMessage ?? "Google login failed.";
			await InvokeAsync(StateHasChanged);
			return;
		}

		ToastService?.Show("Logged in with google successfully");
		
		Navigation.NavigateTo(await GetPostLoginUrlAsync(result.User));
	}

	// Sends users to their profile or setup depending on whether their profile is configured.
	private async Task<string> GetPostLoginUrlAsync(UserSession user)
	{
		if (await AuthSession.IsForumProfileSetupCompleteAsync(user))
		{
			return $"/profile/{user.UserId}";
		}

		return GetProfileSetupUrl(user);
	}

	// Builds the setup route, including the user's ID when available.
	private static string GetProfileSetupUrl(UserSession user)
	{
		return user.UserId > 0
			? $"/profile/setup/{user.UserId}"
			: "/profile/setup";
	}

	// Releases the .NET object reference used by Google's JavaScript callback.
	public void Dispose()
	{
		dotNetReference?.Dispose();
	}

	private enum AuthMode
	{
		Login,
		Signup
	}

	private sealed class LoginModel
	{
		[Required]
		public string Username { get; set; } = string.Empty;

		[Required]
		public string Password { get; set; } = string.Empty;
	}

	private sealed class SignupModel
	{
		[Required]
		public string Username { get; set; } = string.Empty;

		[Required]
		[EmailAddress]
		public string Email { get; set; } = string.Empty;

		[Required]
		[MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
		[RegularExpression(@"^(?=.*[A-Za-z])(?=.*\d)[\s\S]+$", ErrorMessage = "Password must contain at least one letter and one number.")]
		[DataType(DataType.Password)]
		public string Password { get; set; } = string.Empty;

		[Required]
		[Compare(nameof(Password), ErrorMessage = "The passwords does not match each other.")]
		public string ConfirmPassword { get; set; } = string.Empty;
	}
}
