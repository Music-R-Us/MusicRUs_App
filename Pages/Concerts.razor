@page "/concerts"
@layout MainLayout
@using MusicRUs.Services
@inject AuthSessionService AuthSession
@inject BackendApiClient ApiClient
@inject ConcertService ConcertApi
@inject ArtistSubscriptionService SubscriptionApi

<PageTitle>Concerts – MusicRUs</PageTitle>

<section class="grid gap-6">
    <div class="relative overflow-hidden rounded-3xl border border-fiery-terracotta-800 bg-linear-to-br from-fiery-terracotta-900/95 to-fiery-terracotta-700/85 p-8 shadow-xl lg:p-12">
        <div class="grid gap-2">
            <p class="text-xl font-semibold text-porcelain-50">Concerts</p>
            <h1 class="text-4xl font-semibold text-porcelain-50 sm:text-5xl">Upcoming Concerts</h1>
            <p class="text-xl text-porcelain-50">Search for an artist and find their next show.</p>
        </div>
    </div>

    <div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950 p-6 text-porcelain-50">
        <div class="flex flex-wrap gap-3">
            <button type="button" @onclick="() => ChangeViewAsync(false)" disabled="@busy" aria-pressed="@(!showSubscriptions)" class="w-fit rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-granite-800/60 transition">Search artists</button>
            @if(AuthSession.CurrentUser is { UserId: > 0 })
            {
                <button type="button" @onclick="() => ChangeViewAsync(true)" disabled="@busy" aria-pressed="@showSubscriptions" class="w-fit rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-granite-800/60 transition">Subscribed artists</button>
            }
        </div>
        <label for="concert-country" class="grid gap-2 text-sm text-porcelain-50">
            Country
            <select id="concert-country" @bind="countryCode" @bind:after="CountryChangedAsync" disabled="@busy"
                    class="rounded-xl border border-granite-700 bg-coffee-bean-950 px-4 py-3 text-porcelain-50">
                <option value="">All countries</option>
                @foreach (var country in CountryCodes.Countries)
                {
                    <option value="@country.Code">@country.Name (@country.Code)</option>
                }
            </select>
        </label>
        <p class="text-sm text-porcelain-50/60">@locationMessage</p>
        @if (!showSubscriptions)
        {
        <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="flex flex-col gap-3 sm:flex-row">
            <div class="grid flex-1 gap-2">
                <label for="concert-artist" class="text-sm text-porcelain-50">Artist name</label>
                <input id="concert-artist" @bind="query" @bind:event="oninput" placeholder="Search artists…" maxlength="200" disabled="@busy" class="w-full rounded-xl border border-granite-700 bg-coffee-bean-950 px-4 py-3 text-porcelain-50" />
            </div>
            <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(query))" class="w-fit rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-granite-800/60 transition">Search</button>
        </form>
        }
    </div>

    <div aria-live="polite" aria-busy="@busy" class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950 p-6 text-porcelain-50">
        @if (showSubscriptions && !busy)
        {
            <h2 class="text-2xl font-semibold">Subscribed artists</h2>
            @if (AuthSession.CurrentUser is not { UserId: > 0 })
            {
                <p>Log in to see your subscribed artists.</p>
            }
            else if (subscribedArtists.Count == 0 && error is null)
            {
                <p>You have no artist subscriptions yet. Subscribe from an artist’s page.</p>
            }
            @if (AuthSession.CurrentUser is { UserId: > 0 } && string.IsNullOrEmpty(countryCode))
            {
                <p>Select a country above to see concerts for your subscribed artists.</p>
            }
            @foreach (var subscription in subscribedArtists)
            {
                <article class="grid gap-4 rounded-2xl border border-granite-700 bg-granite-900 p-5">
                    <a href="@($"/music/artist/{subscription.ArtistId}")" class="flex items-center gap-3 text-xl font-semibold underline">
                        @if (!string.IsNullOrWhiteSpace(subscription.Artist?.ImageUrl))
                        {
                            <img src="@subscription.Artist.ImageUrl" alt="" class="h-14 w-14 rounded-xl object-cover" />
                        }
                        @(subscription.Artist?.Name ?? $"Artist {subscription.ArtistId}")
                    </a>
                    @if (subscribedConcerts.TryGetValue(subscription.ArtistId, out var shows))
                    {
                        <details @key="subscription.ArtistId" class="rounded-xl border border-granite-700 bg-coffee-bean-950 p-4">
                            <summary class="cursor-pointer rounded-lg font-semibold text-porcelain-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-porcelain-50">
                                Upcoming concerts@(shows is null ? "" : $" ({shows.Count})")
                            </summary>
                            <div class="mt-4 grid gap-3">
                        @if (shows is null)
                        {
                            <p role="alert">Could not load this artist’s concerts. Try refreshing below.</p>
                        }
                        else if (shows.Count == 0)
                        {
                            <p>No upcoming concerts in @countryCode.</p>
                        }
                        else
                        {
                            @foreach (var concert in shows)
                            {
                                <div class="grid gap-2 rounded-xl border border-granite-700 bg-coffee-bean-950 p-4">
                                    <h3 class="text-lg font-semibold">@concert.Name</h3>
                                    <p>@concert.VenueName · @concert.City · @concert.CountryCode</p>
                                    <p>@FormatDate(concert)</p>
                                    @if (TicketUrl(concert.Url) is { } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener noreferrer" class="underline">View concert / tickets</a>
                                    }
                                </div>
                            }
                        }
                            </div>
                        </details>
                    }
                </article>
            }
            @if (AuthSession.CurrentUser is { UserId: > 0 })
            {
                <button type="button" @onclick="LoadSubscriptionsAsync" class="justify-self-start rounded-xl border border-granite-700 bg-granite-900 px-4 py-3 hover:bg-granite-800">Refresh subscriptions and concerts</button>
            }
        }
        @if (busy)
        {
            <p class="text-porcelain-50/60">Loading…</p>
        }
        @if (error is not null)
        {
            <p role="alert" class="rounded-xl border border-fiery-terracotta-400/40 p-4 text-porcelain-50">@error</p>
        }
        @if (!showSubscriptions && searched && !busy && selectedArtist is null && error is null)
        {
            @if (artists.Count == 0)
            {
                <p class="text-porcelain-50/60">No artists found. Try another name.</p>
            }
            else
            {
                <h2 class="text-xl font-semibold">Choose an artist</h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var artist in artists)
                    {
                        <button type="button" @onclick="() => SelectArtistAsync(artist)" class="flex items-center gap-4 rounded-2xl border border-granite-700 bg-coffee-bean-950/60 p-4 text-left hover:border-pine-teal-400">
                            @if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
                            {
                                <img src="@artist.ImageUrl" alt="" class="h-14 w-14 rounded-xl object-cover" />
                            }
                            <span class="font-semibold">@artist.Name</span>
                        </button>
                    }
                </div>
            }
        }
        @if (!showSubscriptions && selectedArtist is not null && !busy)
        {
            <h2 class="text-2xl font-semibold">@selectedArtist.Name concerts</h2>
            @if (error is null && concerts.Count == 0)
            {
                <p class="text-porcelain-50/60">No upcoming concerts found@(string.IsNullOrEmpty(countryCode) ? "." : $" in {countryCode}. Try another country or choose All countries.")</p>
            }
            @foreach (var concert in concerts)
            {
                <article class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
                    <h3 class="text-xl font-semibold">@concert.Name</h3>
                    <p>@concert.VenueName · @string.Join(", ", new[] { concert.City, concert.Region, concert.CountryCode }.Where(value => !string.IsNullOrWhiteSpace(value)))</p>
                    <p class="text-sm text-porcelain-50/70">@FormatDate(concert)</p>
                    @if (TicketUrl(concert.Url) is { } url)
                    {
                        <a href="@url" target="_blank" rel="noopener noreferrer" class="text-pine-teal-300 underline">View concert / tickets ?</a>
                    }
                </article>
            }
        }
    </div>
</section>

@code {
    private string query = string.Empty;
    private string countryCode = string.Empty;
    private string locationMessage = "Choose a country to find shows nearby, or search all countries.";
    private bool busy = true;
    private bool searched;
    private string? error;
    private List<MusicArtist> artists = [];
    private MusicArtist? selectedArtist;
    private List<Concert> concerts = [];
    private bool showSubscriptions;
    private List<ArtistSubscription> subscribedArtists = [];
    private Dictionary<int, List<Concert>?> subscribedConcerts = [];

    /// <summary>
    /// Switches between artist search and subscribed artists, then loads the selected view.
    /// </summary>
    private async Task ChangeViewAsync(bool subscribed)
    {
        if (busy) return;
        showSubscriptions = subscribed;
        error = null;
        if (subscribed) await LoadSubscriptionsAsync();
        else if (selectedArtist is not null) await LoadConcertsAsync();
    }

    /// <summary>
    /// Loads subscribed artists and their upcoming concerts for the selected country.
    /// </summary>
    private async Task LoadSubscriptionsAsync()
    {
        busy = true;
        error = null;
        subscribedArtists = [];
        subscribedConcerts = [];
        try
        {
            if (AuthSession.CurrentUser is not { UserId: > 0 } user) return;
            var subscriptions = await SubscriptionApi.GetByUserAsync(user);
            if (subscriptions is null)
            {
                error = "Could not load subscriptions. Please try refreshing.";
                return;
            }
            subscribedArtists = subscriptions.Where(item => item.ArtistId > 0)
                .DistinctBy(item => item.ArtistId).ToList();
            // Do not fetch worldwide shows when the user has not selected a country.
            if (string.IsNullOrEmpty(countryCode)) return;
            foreach (var subscription in subscribedArtists)
            {
                var results = await ConcertApi.GetByArtistAsync(subscription.ArtistId, countryCode, user);
                subscribedConcerts[subscription.ArtistId] = results?
                    .Where(concert => concert.StartsAt >= DateTimeOffset.UtcNow
                        && string.Equals(concert.CountryCode, countryCode, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(concert => concert.StartsAt).ToList();
            }
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Restores the session and uses the profile location as the initial concert search country.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await AuthSession.InitializeAsync();
        if (AuthSession.CurrentUser is { UserId: > 0 } user)
        {
            var profile = await AuthSession.GetForumProfileAsync(user.UserId);
            countryCode = CountryCodes.FromLocation(profile?.Location) ?? string.Empty;
            locationMessage = countryCode.Length > 0
                ? $"Using your profile location: {profile!.Location} ({countryCode})."
                : "Your profile location could not be matched to a country. Choose one below or search all countries.";
        }
        busy = false;
    }

    /// <summary>
    /// Searches for artists matching the entered name and updates the results or error message.
    /// </summary>
    private async Task SearchAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(query)) return;
        busy = true;
        error = null;
        selectedArtist = null;
        concerts = [];
        artists = [];
        searched = true;
        try
        {
            var results = ApiClient.CanUseBackend
                ? await ApiClient.GetAsync<List<MusicArtist>>($"api/Artist/search?keyword={Uri.EscapeDataString(query.Trim())}", AuthSession.CurrentUser?.AccessToken)
                : null;
            if (results is null) error = "Could not search artists. Please try again.";
            else artists = results.Where(artist => artist.Id > 0).DistinctBy(artist => artist.Id).ToList();
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Selects an artist and loads their upcoming concerts.
    /// </summary>
    private async Task SelectArtistAsync(MusicArtist artist)
    {
        if (busy) return;
        selectedArtist = artist;
        await LoadConcertsAsync();
    }

    /// <summary>
    /// Reloads concerts for the active view after the selected country changes.
    /// </summary>
    private async Task CountryChangedAsync()
    {
        locationMessage = "Country selected for this search.";
        if (showSubscriptions) await LoadSubscriptionsAsync();
        else if (selectedArtist is not null) await LoadConcertsAsync();
    }

    /// <summary>
    /// Loads upcoming concerts for the selected artist, using the selected or profile country when available.
    /// </summary>
    private async Task LoadConcertsAsync()
    {
        if (selectedArtist is null) return;
        busy = true;
        error = null;
        concerts = [];
        try
        {
            var results = await ConcertApi.GetByArtistAsync(selectedArtist.Id, countryCode, AuthSession.CurrentUser);
            if (results is null) error = "Could not load concerts. Please search again to retry.";
            else concerts = results.Where(concert => concert.StartsAt >= DateTimeOffset.UtcNow).OrderBy(concert => concert.StartsAt).ToList();
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Returns an absolute HTTP or HTTPS ticket URL, or null for an unsupported address.
    /// </summary>
    private static string? TicketUrl(string? value) => Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp) ? uri.AbsoluteUri : null;

    /// <summary>
    /// Formats the concert date in the venue time zone, falling back to the supplied offset.
    /// </summary>
    private static string FormatDate(Concert concert)
    {
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(concert.VenueTimeZone);
            return $"{TimeZoneInfo.ConvertTime(concert.StartsAt, zone):ddd, d MMM yyyy · HH:mm} ({concert.VenueTimeZone})";
        }
        catch (Exception exception) when (exception is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
        {
            return $"{concert.StartsAt:ddd, d MMM yyyy · HH:mm zzz}";
        }
    }
}
