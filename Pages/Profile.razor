@page "/{username}"
@page "/profile/{UserId:int}"

@layout MainLayout

@inject MusicRUs.Services.AuthSessionService AuthSession
@inject MusicRUs.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(CurrentProfile?.DisplayName ?? DisplayUsername) Profile</PageTitle>

<section class="w-full">
	@if (!string.IsNullOrWhiteSpace(collectionError))
	{
		<p role="alert" class="p-3 text-sm text-fiery-terracotta-300">@collectionError</p>
	}
	<div class="grid gap-6 rounded-4xl border border-granite-800/80 bg-linear-to-br from-(--profile-start) to-(--profile-end) p-8 shadow-xl backdrop-blur" style="@ProfileBackgroundStyle">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-center gap-5">
				@if (HasAvatar)
				{
					<img src="@CurrentProfile?.AvatarUrl" alt="@DisplayUsername avatar" class="h-20 w-20 rounded-full bg-granite-300 object-cover" />
				}
				else
				{
					<div class="flex h-20 w-20 items-center justify-center rounded-full bg-granite-300 text-3xl font-semibold text-coffee-bean-950">
						@ProfileInitial
					</div>
				}
				<div class="grid gap-1">
					<p class="text-3xl font-semibold text-porcelain-50 font-outline-1">Profile</p>
					<h1 class="text-4xl font-semibold tracking-tight text-porcelain-50 sm:text-5xl font-outline-1">@DisplayUsername</h1>
				</div>
			</div>

			@if (CanEditProfile)
			{
				<div class="flex flex-wrap gap-3 sm:self-center">
					<a href="@EditProfileUrl" class="self-start rounded-full border border-granite-300/60 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-granite-300 transition hover:bg-granite-800 sm:self-center">
						Edit profile
					</a>
					<button type="button"
						@onclick="SignOutAsync"
						class="self-start rounded-full bg-fiery-terracotta-500/90 px-4 py-2 text-sm font-semibold text-porcelain-50 transition hover:bg-fiery-terracotta-500/70 sm:self-center">
						Log Out
					</button>
				</div>
			}
		</div>

		@if (CurrentProfile is not null)
		{
			@if (CurrentProfile.IsPublic == true || CurrentProfile.UserId == AuthSession.CurrentUser?.UserId)
			{
				<div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5 text-porcelain-50/80">
					<div>
						<p class="text-xl font-semibold text-porcelain-50">Profile Information</p>
					</div>
					<div class="grid gap-2">
						<p class="max-w-2xl text-base leading-7 text-porcelain-50/80 sm:text-lg">
							@Bio
						</p>
					</div>
					<div class="grid gap-2 text-sm sm:grid-cols-2">
						<div class="rounded-xl bg-coffee-bean-950/80 px-4 py-3">
							<p class="text-porcelain-50/60">Website</p>
							<a href="@CurrentProfile.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="text-xl font-semibold text-porcelain-50">@(string.IsNullOrWhiteSpace(CurrentProfile.WebsiteUrl) ? "Not set" : CurrentProfile.WebsiteUrl)</a>
						</div>
						<div class="rounded-xl bg-coffee-bean-950/80 px-4 py-3">
							<p class="text-porcelain-50/60">Visibility</p>
							<p class="text-xl font-semibold text-porcelain-50">@(CurrentProfile.IsPublic ? "Public" : "Private")</p>
						</div>
					</div>
					<div class="grid gap-2">
						<div class="rounded-xl bg-coffee-bean-950/80 px-4 py-3">
							<p class="text-porcelain-50/60">Favorite Genres</p>
							@{ var genreNames = string.Join(", ", CurrentProfile.Genres.Select(genre => genre.Name).Where(name => !string.IsNullOrWhiteSpace(name))); }
							<p class="text-xl font-semibold text-porcelain-50">@(string.IsNullOrWhiteSpace(genreNames) ? "Not set" : genreNames)</p>
						</div>
					</div>
				</div>

				<div class="grid gap-6 sm:grid-cols-2">
					<div class="grid content-start gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
						<h2 class="text-xl font-semibold text-porcelain-50">Favorite artists</h2>
						@if (CurrentProfile.FavoriteArtists.Count == 0)
						{
							<p class="text-sm text-porcelain-50/70">No favorite artists yet.</p>
						}
						@foreach (var artist in CurrentProfile.FavoriteArtists)
						{
							<div class="flex items-center gap-3 rounded-xl bg-coffee-bean-950/80 p-3">
								@if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
								{
									<a href="/music/artist/@artist.Id">
										<img src="@artist.ImageUrl" alt="" loading="lazy" class="h-14 w-14 rounded-full object-cover" />
									</a>
								}
								<a href="/music/artist/@artist.Id" class="font-semibold text-porcelain-50">@artist.Name</a>
							</div>
						}
					</div>
					<div class="grid content-start gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
						<h2 class="text-xl font-semibold text-porcelain-50">Favorite albums</h2>
						@if (CurrentProfile.FavoriteAlbums.Count == 0)
						{
							<p class="text-sm text-porcelain-50/70">No favorite albums yet.</p>
						}
						@foreach (var album in CurrentProfile.FavoriteAlbums)
						{
							<div class="flex items-center gap-3 rounded-xl bg-coffee-bean-950/80 p-3">
								@if (!string.IsNullOrWhiteSpace(album.ImageUrl))
								{
									<a href="/music/album/@album.Id">
										<img src="@album.ImageUrl" alt="" loading="lazy" class="h-14 w-14 rounded-lg object-cover" />
									</a>
								}
								<div>
									<a href="/music/album/@album.Id">
										<a href="/music/album/@album.Id" class="font-semibold text-porcelain-50">@album.Title</a>
										<p class="text-sm text-porcelain-50/70">@album.ArtistName</p>
									</a>
								</div>
							</div>
						}

					</div>
					<div class="grid content-start gap-4 self-start rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5 text-porcelain-50/80 sm:col-span-2">
						<button type="button" aria-pressed="@showWanted" @onclick="() => showWanted = !showWanted" class="w-fit rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50">
                            @(showWanted ? "Wanted / Switch to Owned" : "Owned / Switch to Wanted")
                        </button>
                        @if (Collection.Count > 0)
						{
							<div class="grid gap-3">
								<div class="flex items-center justify-between">
									<p class="text-xl font-semibold text-porcelain-50">@(showWanted ? "Wanted albums" : "Owned albums")</p>

								</div>
								@if (CanEditProfile)
								{
									<a href="@(showWanted ? "/collection?wanted=true" : "/collection")" class="text-sm font-medium text-pine-teal-300 transition hover:text-pine-teal-200">Manage →</a>
								}
								<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
									@foreach (var item in Collection.Take(5))
									{
										<div class="flex items-center gap-3 rounded-xl bg-fiery-terracotta-950/70 px-4 py-3">
											@if (!string.IsNullOrWhiteSpace(item.ImageUrl))
											{
												<a href="/music/album/@(item.Album?.Id ?? item.AlbumId)">
													<img src="@item.ImageUrl" alt="@item.AlbumTitle" class="h-12 w-12 rounded-lg object-cover" />
												</a>
											}	
											else
											{
												<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-granite-800 text-xs text-porcelain-50/80">♪</div>
											}
											<div class="min-w-0">
												<a href="/music/album/@(item.Album?.Id ?? item.AlbumId)" class="truncate font-semibold text-porcelain-50">@item.AlbumTitle</a>
												@if (!string.IsNullOrWhiteSpace(item.ArtistNames))
												{
													<p class="truncate text-sm text-porcelain-50/60">@item.ArtistNames</p>
												}
											</div>
										</div>
									}
								</div>
								@if (Collection.Count > 5)
								{
									@if (CanEditProfile)
									{
										<a href="@(showWanted ? "/collection?wanted=true" : "/collection")" class="flex items-center gap-2 rounded-xl border border-granite-700/60 bg-granite-900/40 px-4 py-3 text-sm text-porcelain-50/60 transition hover:bg-granite-900/70 hover:text-porcelain-50">
											<span>and @(Collection.Count - 5) more...</span>
											<span class="ml-auto text-pine-teal-300">See full collection →</span>
										</a>
									}
									else
									{
										<p class="px-1 text-sm text-porcelain-50/40">and @(Collection.Count - 5) more...</p>
									}
								}
							</div>
						}
						else
						{
							<p class="text-xl font-semibold text-porcelain-50">No @(showWanted ? "wanted" : "owned") albums yet.</p>

							@if (CanEditProfile)
							{
								<div class="flex items-end justify-between gap-3 ">
									<a href="@(showWanted ? "/collection?wanted=true" : "/collection")" class="text-sm font-medium text-pine-teal-300 transition hover:text-pine-teal-200">Manage →</a>

								</div>
							}
						}
					</div>
		
				</div>
			}
			else
			{
				<div class="grid gap-2 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5 text-porcelain-50/80">
					<p class="text-xl font-semibold text-porcelain-50">This profile is private.</p>
					<p class="text-sm text-porcelain-50/70">The user has chosen to keep their profile information and music collection private.</p>
				</div>
			}
		}
	</div>
</section>

@code {
	[Parameter]
	public string Username { get; set; } = string.Empty;

	[Parameter]
	public int UserId { get; set; }
	private List<MusicCollectionItem> ownedCollection = [];
	private List<MusicCollectionItem> wantedCollection = [];
	private bool showWanted;
	private string? collectionError;
	private List<MusicCollectionItem> Collection => showWanted ? wantedCollection : ownedCollection;

	private ForumProfile? CurrentProfile;

	/// <summary>

	/// Clears old route identifiers before applying new profile route parameters.

	/// </summary>
	public override Task SetParametersAsync(ParameterView parameters)
	{
		// The router can reuse this component when switching between its routes.
		Username = string.Empty;
		UserId = 0;
		return base.SetParametersAsync(parameters);
	}

	/// <summary>

	/// Accepts only six-digit hex colors before using them in profile styles.

	/// </summary>
	private static string SafeColor(string? value, string fallback)
	{
		return value is { Length: 7 }
			&& value[0] == '#'
			&& value.Skip(1).All(Uri.IsHexDigit) ? value : fallback;
	}

	private string ProfileBackgroundStyle =>
		$"--profile-start: {SafeColor(CurrentProfile?.PrimaryColor, "#2E0B05")}; " +
		$"--profile-end: {SafeColor(CurrentProfile?.AccentColor, "#B82A14")};";

	/// <summary>

	/// Resolves the profile from either route identifier, then loads its owned and wanted albums.

	/// </summary>
	protected override async Task OnParametersSetAsync()
	{
		await AuthSession.InitializeAsync();
		ownedCollection = [];
		wantedCollection = [];
		collectionError = null;
		CurrentProfile = UserId > 0
			? await AuthSession.GetForumProfileAsync(UserId)
			: await AuthSession.GetProfileAsync(Username);
		if (CurrentProfile?.UserId > 0)
		{
			ownedCollection = await AuthSession.GetCollectionAsync(CurrentProfile.UserId);
			collectionError = AuthSession.CollectionError;
			wantedCollection = await AuthSession.GetCollectionAsync(CurrentProfile.UserId, wanted: true);
			collectionError ??= AuthSession.CollectionError;
		}
	}

	private string DisplayUsername => string.IsNullOrWhiteSpace(CurrentProfile?.DisplayName)
		? GetProfileUsernameFallback()
		: CurrentProfile.DisplayName;

	private string Bio => string.IsNullOrWhiteSpace(CurrentProfile?.Bio)
		? "Profile details are not available yet."
		: CurrentProfile.Bio;

	private bool HasAvatar => !string.IsNullOrWhiteSpace(CurrentProfile?.AvatarUrl);

	private string ProfileInitial => string.IsNullOrWhiteSpace(DisplayUsername)
		? "?"
		: DisplayUsername.Trim()[0].ToString().ToUpperInvariant();

	private bool CanEditProfile => AuthSession.CurrentUser is not null
		&& CurrentProfile?.UserId > 0
		&& AuthSession.CurrentUser.UserId == CurrentProfile.UserId;

	private string EditProfileUrl
	{
		get
		{
			var userId = CurrentProfile?.UserId > 0 ? CurrentProfile.UserId : AuthSession.CurrentUser?.UserId ?? 0;
			return userId > 0 ? $"/profile/setup/{userId}" : "/profile/setup";
		}
	}

	/// <summary>

	/// Signs out, displays confirmation, and opens the login page.

	/// </summary>
	private async Task SignOutAsync()
	{
		await AuthSession.SignOutAsync();

		ToastService?.Show("Logged out successfully");

		Navigation.NavigateTo("/loginpick");
	}

	/// <summary>

	/// Uses the loaded username, route username, or a user-ID fallback.

	/// </summary>
	private string GetProfileUsernameFallback()
	{
		if (!string.IsNullOrWhiteSpace(CurrentProfile?.Username))
		{
			return CurrentProfile.Username;
		}

		if (!string.IsNullOrWhiteSpace(Username))
		{
			return Username;
		}

		return CurrentProfile?.UserId > 0 ? $"User {CurrentProfile.UserId}" : "profile";
	}
}
