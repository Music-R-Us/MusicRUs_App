@page "/posts"
@layout MainLayout
@implements IDisposable

@inject MusicRUs.Services.PostFeedService PostFeed
@inject MusicRUs.Services.AuthSessionService AuthSession
@inject MusicRUs.Services.ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Posts</PageTitle>

<section class="grid gap-6">
	<div class="relative flex flex-col gap-4 overflow-hidden rounded-3xl border border-fiery-terracotta-800 bg-linear-to-br from-fiery-terracotta-900/95 to-fiery-terracotta-700/85 p-8 shadow-xl lg:flex-row lg:items-end lg:justify-between lg:p-12">
		<div class="grid gap-2">
			<p class="text-xl font-semibold text-porcelain-50">Recent posts</p>
			<h1 class="text-4xl font-semibold text-porcelain-50 sm:text-5xl">Posts</h1>
			<p class="text-xl  text-porcelain-50">
				Find posts about the things you enjoy or start a new discussion! 
			</p>
		</div>
        @if(AuthSession.CurrentUser is not null)
        {
        <button class="w-fit rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50 hover:bg-granite-800/60 transition"
			type="button" @onclick="OpenComposer"> + New Post
		</button>
        }

	</div>

	<div class="grid gap-4 rounded-3xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
		<div class="grid gap-4 lg:grid-cols-2">
			<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
				<span>Search posts</span>
				<input value="@postSearch" @oninput="OnPostSearchInput" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
			</label>
			<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
				<span>Search genres</span>
				<input value="@feedTagSearch" @oninput="OnFeedTagSearchInput" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
			</label>
		</div>

		@if (selectedFeedTags.Count > 0)
		{
			<div class="flex flex-wrap gap-2">
				@foreach (var tag in selectedFeedTags)
				{
					<button type="button" @onclick="() => RemoveFeedTag(tag)" class="rounded-full border border-pine-teal-400/30 bg-pine-teal-400/10 px-3 py-1 text-sm text-pine-teal-100 transition hover:border-pine-teal-300">
						#@tag x
					</button>
				}
			</div>
		}

		@if (FilteredFeedTagSuggestions.Count > 0)
		{
			<div class="flex flex-wrap gap-2">
				@foreach (var tag in FilteredFeedTagSuggestions)
				{
					<button type="button" @onclick="() => AddFeedTag(tag)" class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50 transition hover:border-pine-teal-300 hover:text-pine-teal-200">
						#@tag
					</button>
				}
			</div>
		}
	</div>

	<div class="grid gap-4">
		@if (FeedPosts.Count == 0)
		{
			<div class="rounded-3xl border border-granite-800/70 bg-coffee-bean-950/70 p-6 text-porcelain-50/75">
				<p class="text-lg font-semibold text-porcelain-50">No posts yet</p>
				<p class="mt-2 text-sm leading-6">Looks like it's just us here.</p>
			</div>
		}
		else
		{
			@if (FilteredFeedPosts.Count == 0)
			{
				<div class="rounded-3xl border border-granite-800/70 bg-coffee-bean-950/70 p-6 text-porcelain-50/75">
					<p class="text-lg font-semibold text-porcelain-50">No matching posts</p>
					<p class="mt-2 text-sm leading-6">Try another post search or genre.</p>
				</div>
			}
			@foreach (var post in FilteredFeedPosts)
			{
				<article class="@GetPostCardClass(post)">
					<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
						<div class="grid gap-3">
							<div class="flex flex-wrap items-center gap-2 text-sm text-porcelain-50/70">
								@if (IsHighlightedOwnPost(post))
								{
									<span class="rounded-full border border-pine-teal-400/30 bg-pine-teal-400/10 px-2 py-1 text-pine-teal-300">Your post</span>
								}
								<a href="@GetAuthorProfileUrl(post)" class="text-porcelain-50 underline-offset-4 transition hover:text-porcelain-50 hover:underline">
									@GetAuthorDisplayName(post)
								</a>
							</div>

							<a href="@($"/posts/{post.RouteId}")" class="text-xl font-semibold text-porcelain-50">@post.Title</a>
							<p class="text-sm text-porcelain-50">@post.Body</p>
						</div>

						@if (HasMusicSelection(post))
						{
							<div class="grid gap-2 text-sm text-porcelain-50/70 lg:min-w-64 lg:justify-items-end">
								<p class="font-medium text-porcelain-50">@post.Artist</p>
								<p>@post.Album</p>
								@if (!string.IsNullOrWhiteSpace(post.Song)) { <p>@post.Song</p> }
							</div>
						}
					</div>

					<div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-porcelain-50/70">
						@foreach (var tag in post.Tags)
						{
							<span class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1">#@tag</span>
						}
						@if (IsOwnPost(post))
						{
							<button type="button"
								@onclick="() => DeletePostAsync(post)"
								class="rounded-full border border-red-400/30 bg-red-400/10 px-3 py-1 text-sm uppercase text-red-100 transition hover:border-red-300 hover:bg-red-400/20">
								Delete
							</button>
						}
						<span class="ml-auto text-sm text-granite-300">@(post.CommentCount > 0 ? post.CommentCount : post.Comments.Count) comments</span>
					</div>
				</article>
			}
		}
	</div>
</section>

@if (IsComposerOpen)
{
	<div class="fixed inset-0 z-40 flex items-center justify-center bg-coffee-bean-950/80 px-4 py-8 backdrop-blur-sm">
		<div class="max-h-[calc(100vh-4rem)] w-full max-w-4xl overflow-y-auto rounded-4xl border border-granite-800/80 bg-coffee-bean-950 p-6 shadow-2xl shadow-black/30 lg:p-8">
			<div class="flex items-start justify-between gap-4">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.3em] text-pine-teal-300">Compose</p>
					<h2 class="mt-2 text-3xl font-semibold tracking-tight text-porcelain-50">New Post</h2>
				</div>
				<button class="rounded-full border border-granite-700 px-3 py-1 text-sm text-porcelain-50/70 transition hover:bg-granite-900"
					type="button"
					@onclick="CloseComposer">
					Close
				</button>
			</div>

			<EditForm Model="Draft" OnValidSubmit="CreatePostAsync" class="mt-6 grid gap-5">
				<DataAnnotationsValidator />
				<div class="grid gap-5 lg:grid-cols-2">
					<div class="grid gap-4">
						<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
							<span>Title</span>
							<InputText @bind-Value="Draft.Title" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
							<span class="text-xs text-porcelain-50/60">At least 8 characters.</span>
							<ValidationMessage For="@(() => Draft.Title)" class="text-sm text-red-100" />
						</label>

						<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
							<span>What do you want to write?</span>
							<InputTextArea @bind-Value="Draft.Body" rows="8" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
							<span class="text-xs text-porcelain-50/60">At least 8 characters.</span>
							<ValidationMessage For="@(() => Draft.Body)" class="text-sm text-red-100" />
						</label>

						<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
							<span>Search genres</span>
							<input value="@tagSearch" @oninput="OnTagsInput" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
						</label>
						@if (selectedTags.Count > 0)
						{
							<div class="flex flex-wrap gap-2">
								@foreach (var tag in selectedTags)
								{
									<button type="button" @onclick="() => RemoveTag(tag)" class="rounded-full border border-pine-teal-400/30 bg-pine-teal-400/10 px-3 py-1 text-sm text-pine-teal-100 transition hover:border-pine-teal-300">
										#@tag x
									</button>
								}
							</div>
						}
						@if (FilteredTagSuggestions.Count > 0)
						{
							<div class="flex flex-wrap gap-2">
								@foreach (var tag in FilteredTagSuggestions)
								{
									<button type="button" @onclick="() => AddTag(tag)" class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50 transition hover:border-pine-teal-300 hover:text-pine-teal-200">
										#@tag
									</button>
								}
							</div>
						}
					</div>

					<div class="grid gap-4">
						<div class="grid gap-3 rounded-3xl border border-granite-800 bg-coffee-bean-900/40 p-4 text-sm text-porcelain-50/80">
							<span class="font-medium text-porcelain-50">Music selection</span>
							<InputRadioGroup @bind-Value="Draft.MusicType" @bind-Value:after="OnMusicTypeChanged" class="flex flex-wrap gap-4">
								@foreach (var type in Enum.GetValues<MusicRUs.Models.MusicLinkType>())
								{
									<label class="flex items-center gap-2"><InputRadio Value="type" /><span>@(type == MusicRUs.Models.MusicLinkType.None ? "No music" : type.ToString())</span></label>
								}
							</InputRadioGroup>
						</div>

						@if (Draft.RequiresMusicSelection)
						{
							@if (Draft.MusicType == MusicRUs.Models.MusicLinkType.Artist)
							{
							<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
								<span>Artist</span>
								<input value="@Draft.Selection.Artist" @oninput="OnArtistInputAsync" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
							</label>
							@if (isSearchingArtists)
							{
								<p class="text-sm text-porcelain-50/60">Searching...</p>
							}
							@if (artistResults.Count > 0)
							{
								<div class="grid gap-2 rounded-2xl border border-granite-800 bg-coffee-bean-950/70 p-3">
									@foreach (var artist in artistResults)
									{
										<button type="button" @onclick="() => SelectArtistAsync(artist)" class="flex items-center gap-3 rounded-xl px-3 py-2 text-left text-sm text-porcelain-50 transition hover:bg-granite-900/80">
											@if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
											{
												<img src="@artist.ImageUrl" alt="@artist.Name" class="h-10 w-10 rounded-lg object-cover" />
											}
											<span class="font-semibold">@artist.Name</span>
										</button>
									}
								</div>
							}

							}
							@if (Draft.MusicType is MusicRUs.Models.MusicLinkType.Album or MusicRUs.Models.MusicLinkType.Track)
							{
							<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
								<span>Album</span>
								<input value="@Draft.Selection.Album" @oninput="OnAlbumInputAsync" class="rounded-2xl border border-granite-700 bg-coffee-bean-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-pine-teal-400" />
							</label>
							@if (isSearchingAlbums)
							{
								<p class="text-sm text-porcelain-50/60">Searching...</p>
							}
							@if (albumResults.Count > 0)
							{
								<div class="grid gap-2 rounded-2xl border border-granite-800 bg-coffee-bean-950/70 p-3">
									@foreach (var album in albumResults)
									{
										<button type="button" @onclick="() => SelectAlbumAsync(album)" class="flex items-center gap-3 rounded-xl px-3 py-2 text-left text-sm text-porcelain-50 transition hover:bg-granite-900/80">
											@if (!string.IsNullOrWhiteSpace(album.ImageUrl))
											{
												<img src="@album.ImageUrl" alt="@album.Title" class="h-10 w-10 rounded-lg object-cover" />
											}
											<span>
												<span class="block font-semibold">@album.Title</span>
												<span class="block text-xs text-porcelain-50/60">@album.ArtistName</span>
												@if (!string.IsNullOrWhiteSpace(album.ReleaseDate))
												{
													<span class="text-xs text-porcelain-50/60">@album.ReleaseDate</span>
												}
											</span>
										</button>
									}
								</div>
							}

							}
							@if (Draft.MusicType == MusicRUs.Models.MusicLinkType.Track && Draft.Selection.AlbumId > 0)
							{
								<label class="grid gap-2 text-sm font-medium text-porcelain-50/80">
									<span>Track</span>
									<InputSelect @bind-Value="Draft.Selection.TrackId" @bind-Value:after="OnTrackSelected" class="rounded-2xl border border-granite-700 bg-coffee-bean-900 px-4 py-3 text-porcelain-50">
										<option value="0">Select a track</option>
										@foreach (var track in trackResults)
										{
											<option value="@track.Id">@track.Title</option>
										}
									</InputSelect>
								</label>
								@if (isLoadingTracks) { <p class="text-sm text-porcelain-50/60">Loading tracks...</p> }
								else if (trackResults.Count == 0) { <p class="text-sm text-porcelain-50/60">No tracks available for this album. Choose another album.</p> }
							}
						}
					</div>
				</div>

				@if (!string.IsNullOrWhiteSpace(ComposerError))
				{
					<p class="rounded-2xl border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-100">@ComposerError</p>
				}

				<div class="sticky bottom-0 flex flex-col-reverse gap-3 border-t border-granite-800 bg-coffee-bean-950 pt-5 sm:flex-row sm:items-center sm:justify-end">
					<button class="rounded-full border border-granite-700 px-5 py-3 text-sm font-medium text-porcelain-50/80 transition hover:bg-granite-900" type="button" @onclick="CloseComposer">Cancel</button>
					<button class="rounded-full border-2 border-porcelain-50/80 bg-fiery-terracotta-500 px-6 py-3 text-sm font-bold text-porcelain-50 shadow-lg shadow-black/30 transition hover:border-porcelain-50 hover:bg-fiery-terracotta-400" type="submit">Publish Post</button>
				</div>
			</EditForm>
		</div>
	</div>
}

@code {
	private readonly MusicRUs.Models.PostDraft Draft = new();
	private bool IsComposerOpen;
	private IReadOnlyList<MusicRUs.Models.PostItem> FeedPosts = [];
	private List<MusicRUs.Models.MusicArtist> artistResults = [];
	private List<MusicRUs.Models.MusicAlbum> albumResults = [];
	private List<MusicRUs.Models.MusicTrack> trackResults = [];
	private bool isLoadingTracks;
	private CancellationTokenSource? trackLoad;
	private List<MusicRUs.Models.GenreOption> genreOptions = [];
	private List<string> selectedTags = [];
	private List<string> selectedFeedTags = [];
	private Dictionary<int, MusicRUs.Models.ForumProfile> AuthorProfiles = [];
	private Dictionary<int, MusicRUs.Models.UserSession> AuthorUsers = [];
	private CancellationTokenSource? artistSearchDebounce;
	private CancellationTokenSource? albumSearchDebounce;
	private bool isSearchingArtists;
	private bool isSearchingAlbums;
	private string ComposerError = string.Empty;
	private string tagSearch = string.Empty;
	private string postSearch = string.Empty;
	private string feedTagSearch = string.Empty;

	private IReadOnlyList<string> FilteredTagSuggestions => FilterSuggestions(GetGenreSuggestions(), tagSearch, selectedTags);
	private IReadOnlyList<string> FilteredFeedTagSuggestions => FilterSuggestions(GetGenreSuggestions(), feedTagSearch, selectedFeedTags);
	private IReadOnlyList<MusicRUs.Models.PostItem> FilteredFeedPosts => FeedPosts
		.Where(MatchesPostSearch)
		.Where(MatchesFeedTags)
		.ToList();

	/// <summary>
	/// Initializes the session, loads genre choices, and populates the feed.
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		await AuthSession.InitializeAsync();
		genreOptions = await AuthSession.GetGenresAsync();
		await LoadFeedAsync();
	}

	/// <summary>
	/// Refreshes the feed and loads its authors' display details.
	/// </summary>
	private async Task LoadFeedAsync()
	{
		FeedPosts = await PostFeed.GetRecentPostsAsync(AuthSession.CurrentUser);
		await LoadAuthorProfilesAsync();
	}

	/// <summary>
	/// Loads profile details for feed authors so cards can show their current names and avatars.
	/// </summary>
	private async Task LoadAuthorProfilesAsync()
	{
		AuthorProfiles = [];
		AuthorUsers = [];
		foreach (var userId in FeedPosts.Select(post => post.UserId).Where(userId => userId > 0).Distinct())
		{
			try
			{
				var profile = await AuthSession.GetForumProfileAsync(userId);
				if (profile is not null)
				{
					AuthorProfiles[userId] = profile;
				}

				var user = await AuthSession.GetUserAsync(userId);
				if (user is not null)
				{
					AuthorUsers[userId] = user;
				}
			}
			catch
			{
				// Keep the posts page available even if an author lookup fails.
			}
		}
	}

	/// <summary>
	/// Opens the post form and clears its previous error.
	/// </summary>
	private void OpenComposer()
	{
		ComposerError = string.Empty;
		IsComposerOpen = true;
	}

	/// <summary>
	/// Closes the post form while retaining its draft.
	/// </summary>
	private void CloseComposer() => IsComposerOpen = false;

	/// <summary>
	/// Cancels track loading and clears the selected track and available tracks.
	/// </summary>
	private void ResetTracks()
	{
		trackLoad?.Cancel();
		trackLoad = null;
		isLoadingTracks = false;
		trackResults = [];
		Draft.Selection.TrackId = 0;
		Draft.Selection.Track = string.Empty;
	}

	/// <summary>
	/// Clears music selections and pending searches when the linked music type changes.
	/// </summary>
	private void OnMusicTypeChanged()
	{
		CancelArtistSearchDebounce();
		CancelAlbumSearchDebounce();
		ResetTracks();
		Draft.RequiresMusicSelection = Draft.MusicType != MusicRUs.Models.MusicLinkType.None;
		Draft.Selection = new();
		artistResults = [];
		albumResults = [];
		isSearchingArtists = false;
		isSearchingAlbums = false;
		ComposerError = string.Empty;
	}

	/// <summary>
	/// Copies the selected track's title into the draft and clears its error.
	/// </summary>
	private void OnTrackSelected()
	{
		Draft.Selection.Track = trackResults.FirstOrDefault(track => track.Id == Draft.Selection.TrackId)?.Title ?? string.Empty;
		ComposerError = string.Empty;
	}

	/// <summary>
	/// Updates the text used to filter composer genre suggestions.
	/// </summary>
	private void OnTagsInput(ChangeEventArgs args)
	{
		tagSearch = args.Value?.ToString() ?? string.Empty;
	}

	/// <summary>
	/// Updates the text used to filter posts in the feed.
	/// </summary>
	private void OnPostSearchInput(ChangeEventArgs args)
	{
		postSearch = args.Value?.ToString() ?? string.Empty;
	}

	/// <summary>
	/// Updates the text used to filter the feed's genre suggestions.
	/// </summary>
	private void OnFeedTagSearchInput(ChangeEventArgs args)
	{
		feedTagSearch = args.Value?.ToString() ?? string.Empty;
	}

	/// <summary>
	/// Updates artist text, clears dependent selections, and schedules an artist search.
	/// </summary>
	private async Task OnArtistInputAsync(ChangeEventArgs args)
	{
		ResetTracks();
		var nextArtist = args.Value?.ToString() ?? string.Empty;
		if (!string.Equals(Draft.Selection.Artist, nextArtist, StringComparison.Ordinal))
		{
			Draft.Selection.Artist = nextArtist;
			Draft.Selection.ArtistId = 0;
			Draft.Selection.Album = string.Empty;
			Draft.Selection.AlbumId = 0;
		}

		artistResults = [];
		albumResults = [];
		await DebounceArtistSearchAsync();
	}

	/// <summary>
	/// Updates album text, clears the selected album and track, and schedules a search.
	/// </summary>
	private async Task OnAlbumInputAsync(ChangeEventArgs args)
	{
		ResetTracks();
		Draft.Selection.Album = args.Value?.ToString() ?? string.Empty;
		Draft.Selection.AlbumId = 0;
		albumResults = [];
		Draft.Selection.AlbumImageUrl = string.Empty;
		await DebounceAlbumSearchAsync();
	}

	/// <summary>
	/// Selects an artist result and clears album, track, and search state.
	/// </summary>
	private void SelectArtistAsync(MusicRUs.Models.MusicArtist artist)
	{
		CancelArtistSearchDebounce();
		CancelAlbumSearchDebounce();
		ResetTracks();
		Draft.Selection.Artist = artist.Name;
		Draft.Selection.ArtistId = artist.Id;
		Draft.Selection.Album = string.Empty;
		Draft.Selection.AlbumId = 0;
		artistResults = [];
		albumResults = [];
		ComposerError = string.Empty;
	}

	/// <summary>
	/// Loads tracks for the chosen album so a track can be linked to the post.
	/// </summary>
	private async Task SelectAlbumAsync(MusicRUs.Models.MusicAlbum album)
	{
		CancelAlbumSearchDebounce();
		ResetTracks();
		Draft.Selection.Album = album.Title;
		Draft.Selection.AlbumId = album.Id;
		Draft.Selection.AlbumImageUrl = album.ImageUrl;
		albumResults = [];
		ComposerError = string.Empty;
		if (Draft.MusicType != MusicRUs.Models.MusicLinkType.Track) return;
		using var load = new CancellationTokenSource();
		trackLoad = load;
		isLoadingTracks = true;
		try
		{
			var tracks = await AuthSession.GetAlbumTracksAsync(album.Id, load.Token);
			if (ReferenceEquals(trackLoad, load)) trackResults = tracks;
		}
		catch (OperationCanceledException) { }
		catch (HttpRequestException)
		{
			if (ReferenceEquals(trackLoad, load)) ComposerError = "Could not load tracks. Select the album again to retry.";
		}
		finally
		{
			if (ReferenceEquals(trackLoad, load))
			{
				trackLoad = null;
				isLoadingTracks = false;
			}
		}
	}

	/// <summary>
	/// Adds a unique genre to the draft and refreshes its saved genre fields.
	/// </summary>
	private void AddTag(string tag)
	{
		if (!selectedTags.Contains(tag, StringComparer.OrdinalIgnoreCase))
		{
            ToastService.Show("Genre added");

			selectedTags.Add(tag);
		}

		tagSearch = string.Empty;
		SyncDraftTags();
	}

	/// <summary>
	/// Removes a draft genre and refreshes its saved genre fields.
	/// </summary>
	private void RemoveTag(string tag)
	{
		if (selectedTags.RemoveAll(existing => string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)) > 0)
		{
			ToastService.Show("Genre removed");
		}
		SyncDraftTags();
	}

	/// <summary>
	/// Adds a unique genre filter to the feed and clears the suggestion text.
	/// </summary>
	private void AddFeedTag(string tag)
	{
		if (!selectedFeedTags.Contains(tag, StringComparer.OrdinalIgnoreCase))
		{
            ToastService.Show("Genre added");

			selectedFeedTags.Add(tag);
		}

		feedTagSearch = string.Empty;
	}

	/// <summary>
	/// Removes a genre filter from the feed.
	/// </summary>
	private void RemoveFeedTag(string tag)
	{
		if (selectedFeedTags.RemoveAll(existing => string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)) > 0)
		{
			ToastService.Show("Genre removed");
		}
	}

	/// <summary>
	/// Deletes the current user's selected post and reloads the feed after success.
	/// </summary>
	private async Task DeletePostAsync(MusicRUs.Models.PostItem post)
	{
		if (!IsOwnPost(post))
		{
			return;
		}

		if (await PostFeed.DeletePostAsync(post, AuthSession.CurrentUser))
		{
            ToastService.Show("Post deleted successfully!");

			await LoadFeedAsync();
		}
	}

	/// <summary>
	/// Validates the music selection, saves the post, and resets the form only after success.
	/// </summary>
	private async Task CreatePostAsync()
	{
		if (string.IsNullOrWhiteSpace(AuthSession.CurrentUser?.Username))
		{
			return;
		}

		ComposerError = string.Empty;
		var hasSelection = Draft.MusicType switch
		{
			MusicRUs.Models.MusicLinkType.None => true,
			MusicRUs.Models.MusicLinkType.Artist => Draft.Selection.ArtistId > 0,
			MusicRUs.Models.MusicLinkType.Album => Draft.Selection.AlbumId > 0,
			MusicRUs.Models.MusicLinkType.Track => Draft.Selection.TrackId > 0,
			_ => false
		};
		if (!hasSelection)
		{	
			ComposerError = $"Select a {Draft.MusicType.ToString().ToLowerInvariant()} from the available results, or choose No music.";
			return;
		}

		try
		{
			await PostFeed.CreatePostAsync(Draft, AuthSession.CurrentUser);
		}
		catch (InvalidOperationException exception)
		{
			ComposerError = exception.Message;
			return;
		}
		catch (HttpRequestException)
		{
			ComposerError = "Could not reach the API. Please try again.";
			return;
		}
		catch (OperationCanceledException)
		{
			ComposerError = "The save request timed out. Check the feed before trying again.";
			return;
		}
		Draft.Title = string.Empty;
		Draft.Body = string.Empty;
		Draft.TagsText = string.Empty;
		Draft.GenreIds = [];

		tagSearch = string.Empty;
		selectedTags = [];

		Draft.RequiresMusicSelection = true;
		Draft.MusicType = MusicRUs.Models.MusicLinkType.Album;

		ResetTracks();
		Draft.Selection = new MusicRUs.Models.MusicSelection();
		
		await LoadFeedAsync();
		IsComposerOpen = false;

        ToastService.Show("Post created successfully!");

		Navigation.NavigateTo("/posts", forceLoad: false);
	}

	/// <summary>
	/// Waits for typing to pause and cancels the previous artist search.
	/// </summary>
	private async Task DebounceArtistSearchAsync()
	{
		CancelArtistSearchDebounce();

		if (Draft.Selection.Artist.Trim().Length < 2)
		{
			isSearchingArtists = false;
			return;
		}

		var debounce = new CancellationTokenSource();
		artistSearchDebounce = debounce;
		isSearchingArtists = true;
		await InvokeAsync(StateHasChanged);

		try
		{
			await Task.Delay(TimeSpan.FromSeconds(2), debounce.Token);
			artistResults = (await AuthSession.SearchArtistsAsync(Draft.Selection.Artist, debounce.Token))
				.Take(5)
				.ToList();
		}
		catch (OperationCanceledException)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(artistSearchDebounce, debounce))
			{
				artistSearchDebounce = null;
				isSearchingArtists = false;
				debounce.Dispose();
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	/// <summary>
	/// Waits for typing to pause and cancels the previous album search.
	/// </summary>
	private async Task DebounceAlbumSearchAsync()
	{
		CancelAlbumSearchDebounce();

		if (Draft.Selection.Album.Trim().Length < 2)
		{
			isSearchingAlbums = false;
			return;
		}

		var debounce = new CancellationTokenSource();
		albumSearchDebounce = debounce;
		isSearchingAlbums = true;
		await InvokeAsync(StateHasChanged);

		try
		{
			await Task.Delay(TimeSpan.FromSeconds(2), debounce.Token);
			var albumSearch = Draft.Selection.Album.Trim();
			albumResults = (await AuthSession.SearchAlbumsAsync(albumSearch, debounce.Token))
				.Where(album => !string.IsNullOrWhiteSpace(album.Title))
				.Where(album => album.Title.Contains(albumSearch, StringComparison.OrdinalIgnoreCase))
				.Take(5)
				.ToList();
		}
		catch (OperationCanceledException)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(albumSearchDebounce, debounce))
			{
				albumSearchDebounce = null;
				isSearchingAlbums = false;
				debounce.Dispose();
				await InvokeAsync(StateHasChanged);
			}
		}
	}

	/// <summary>
	/// Returns unique genre names from the loaded genre choices.
	/// </summary>
	private IEnumerable<string> GetGenreSuggestions()
	{
		return genreOptions
			.Select(genre => genre.Name)
			.Distinct(StringComparer.OrdinalIgnoreCase);
	}

	/// <summary>
	/// Returns up to eight matching suggestions, excluding blanks and existing selections.
	/// </summary>
	private static IReadOnlyList<string> FilterSuggestions(IEnumerable<string> suggestions, string search, IEnumerable<string>? excluded = null)
	{
		var excludedSet = new HashSet<string>(excluded ?? [], StringComparer.OrdinalIgnoreCase);
		var trimmedSearch = search.Trim();
		return suggestions
			.Where(suggestion => !string.IsNullOrWhiteSpace(suggestion))
			.Where(suggestion => !excludedSet.Contains(suggestion))
			.Where(suggestion => string.IsNullOrWhiteSpace(trimmedSearch) || suggestion.Contains(trimmedSearch, StringComparison.OrdinalIgnoreCase))
			.Take(8)
			.ToList();
	}

	/// <summary>
	/// Copies selected genre names and IDs into the draft submitted to the service.
	/// </summary>
	private void SyncDraftTags()
	{
		Draft.TagsText = string.Join(", ", selectedTags.Distinct(StringComparer.OrdinalIgnoreCase));
		Draft.GenreIds = genreOptions
			.Where(genre => selectedTags.Contains(genre.Name, StringComparer.OrdinalIgnoreCase))
			.Select(genre => genre.Id)
			.Distinct()
			.ToList();
	}

	/// <summary>
	/// Matches search text against the post's content, music, tags, or author.
	/// </summary>
	private bool MatchesPostSearch(MusicRUs.Models.PostItem post)
	{
		var search = postSearch.Trim();
		if (string.IsNullOrWhiteSpace(search))
		{
			return true;
		}

		return ContainsSearch(post.Title, search)
			|| ContainsSearch(post.Body, search)
			|| ContainsSearch(post.Artist, search)
			|| ContainsSearch(post.Album, search)
			|| post.Tags.Any(tag => ContainsSearch(tag, search))
			|| ContainsSearch(GetAuthorDisplayName(post), search);
	}

	/// <summary>
	/// Includes a post when it contains every selected genre filter.
	/// </summary>
	private bool MatchesFeedTags(MusicRUs.Models.PostItem post)
	{
		return selectedFeedTags.Count == 0
			|| selectedFeedTags.All(selectedTag => post.Tags.Any(postTag => string.Equals(postTag, selectedTag, StringComparison.OrdinalIgnoreCase)));
	}

	/// <summary>
	/// Checks whether nonblank text contains the search term, ignoring capitalization.
	/// </summary>
	private static bool ContainsSearch(string? value, string search)
	{
		return !string.IsNullOrWhiteSpace(value)
			&& value.Contains(search, StringComparison.OrdinalIgnoreCase);
	}

	/// <summary>
	/// Checks whether the post contains an artist, album, or song name.
	/// </summary>
	private static bool HasMusicSelection(MusicRUs.Models.PostItem post)
	{
		return !string.IsNullOrWhiteSpace(post.Artist)
			|| !string.IsNullOrWhiteSpace(post.Album)
			|| !string.IsNullOrWhiteSpace(post.Song);
	}

	/// <summary>
	/// Checks whether this post qualifies for the current user's recent-post highlight.
	/// </summary>
	private bool IsHighlightedOwnPost(MusicRUs.Models.PostItem post)
	{
		return MusicRUs.Services.PostFeedService.IsRecentOwnPost(post, AuthSession.CurrentUser);
	}

	/// <summary>
	/// Checks ownership using the user's ID or matching username.
	/// </summary>
	private bool IsOwnPost(MusicRUs.Models.PostItem post)
	{
		return MusicRUs.Services.PostFeedService.IsOwnPost(post, AuthSession.CurrentUser);
	}

	/// <summary>
	/// Builds post-card styling, highlighting the current user's recent posts.
	/// </summary>
	private string GetPostCardClass(MusicRUs.Models.PostItem post)
	{
		var highlightClasses = IsHighlightedOwnPost(post)
			? "border-pine-teal-400/60 bg-coffee-bean-900/90"
			: "border-granite-800/70 bg-coffee-bean-950/70";

		return $"group rounded-3xl border {highlightClasses} p-5 transition hover:-translate-y-0.5 hover:border-pine-teal-400/40 hover:bg-coffee-bean-900/80";
	}

	/// <summary>
	/// Uses the author's profile name, username, or user-ID fallback.
	/// </summary>
	private string GetAuthorDisplayName(MusicRUs.Models.PostItem post)
	{
		if (post.UserId > 0 && AuthorProfiles.TryGetValue(post.UserId, out var profile) && !string.IsNullOrWhiteSpace(profile.DisplayName))
		{
			return profile.DisplayName;
		}

		return post.UserId > 0 && AuthorUsers.TryGetValue(post.UserId, out var user) && !string.IsNullOrWhiteSpace(user.Username)
			? user.Username
			: $"User {post.UserId}";
	}

	/// <summary>
	/// Builds the author's profile link or falls back to the posts page.
	/// </summary>
	private string GetAuthorProfileUrl(MusicRUs.Models.PostItem post)
	{
		if (post.UserId > 0)
		{
			return $"/profile/{post.UserId}";
		}

		return "/posts";
	}

	/// <summary>
	/// Cancels pending track loads and catalog searches when leaving the page.
	/// </summary>
	public void Dispose()
	{
		ResetTracks();
		CancelArtistSearchDebounce();
		CancelAlbumSearchDebounce();
	}

	/// <summary>
	/// Cancels the pending artist search and clears its active token reference.
	/// </summary>
	private void CancelArtistSearchDebounce()
	{
		var debounce = artistSearchDebounce;
		artistSearchDebounce = null;
		if (debounce is null)
		{
			return;
		}

		try
		{
			debounce.Cancel();
		}
		catch (ObjectDisposedException)
		{
		}

		debounce.Dispose();
	}

	/// <summary>
	/// Cancels the pending album search and clears its active token reference.
	/// </summary>
	private void CancelAlbumSearchDebounce()
	{
		var debounce = albumSearchDebounce;
		albumSearchDebounce = null;
		if (debounce is null)
		{
			return;
		}

		try
		{
			debounce.Cancel();
		}
		catch (ObjectDisposedException)
		{
		}

		debounce.Dispose();
	}
}
