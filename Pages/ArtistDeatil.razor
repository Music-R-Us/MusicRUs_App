@page "/music/artist/{ArtistId:int}"

@layout MainLayout

@inject MusicRUs.Services.AuthSessionService AuthSession
@inject MusicRUs.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject MusicRUs.Services.ConcertService ConcertApi
@inject MusicRUs.Services.ArtistSubscriptionService SubscriptionApi
@using MusicRUs.Services

<PageTitle>@(artist?.Name ?? "Artist") – MusicRUs</PageTitle>

@if (isLoading)
{
    <div class="rounded-2xl border border-granite-800/80 bg-coffee-bean-950 py-12 text-center text-porcelain-50/80">Loading...</div>
}
else if (artist is null)
{
    <div class="grid gap-4 rounded-2xl border border-granite-800/80 gradient-surface p-8 text-center backdrop-blur">
        <p class="text-porcelain-50/60">Artist not found.</p>
        <a href="/music"
           class="mx-auto rounded-full border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm text-porcelain-50 transition hover:bg-granite-800">
            ← Back to Music
        </a>
    </div>
}
else
{
    <section class="w-full">
        <div class="grid gap-8">
            @if (!string.IsNullOrWhiteSpace(AuthSession.CollectionError))
            {
                <p role="alert" class="rounded-2xl border border-fiery-terracotta-400/40 bg-coffee-bean-950 p-3 text-sm text-fiery-terracotta-300">
                    @AuthSession.CollectionError</p>
                }

                @* Artist header *@
                <div class="relative overflow-hidden rounded-3xl border border-granite-800/80 bg-coffee-bean-950/60">
                    <div class="flex flex-col gap-6 p-8 sm:flex-row sm:items-end">
                        @if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
                        {
                            <img src="@artist.ImageUrl" alt="@artist.Name" class="h-36 w-36 rounded-2xl object-cover shadow-lg shadow-black/40" />
                        }
                        else
                        {
                            <div
                                class="flex h-36 w-36 items-center justify-center rounded-2xl bg-pine-teal-300 text-5xl font-bold text-coffee-bean-950">
                                @(artist.Name.Length > 0 ? artist.Name[0].ToString().ToUpperInvariant() : "?")
                            </div>
                        }
                        <div class="grid gap-2">
                            <p class="text-xl font-semibold text-porcelain-50">Artist</p>
                            <h1 class="text-5xl font-semibold text-porcelain-50">@artist.Name</h1>
                            <p class="text-sm text-porcelain-50/50 m-1">@albums.Count album@(albums.Count == 1 ? "" : "s")</p>
                        </div>
                    </div>
                </div>

                @* Albums + tracks *@
                <div class="flex flex-wrap items-end gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950 p-5 text-porcelain-50">
                @if (AuthSession.IsAuthenticated && !showConcerts)
                {
                    <label class="grid max-w-xs gap-1 text-sm text-porcelain-50/80">
                        Media format for albums you add
                        <select @bind="selectedFormat"
                                class="rounded-xl border border-granite-700 bg-coffee-bean-950 px-3 py-2 text-porcelain-50">
                            <option value="">Choose format</option>
                            @foreach (var format in Enum.GetValues<MediaFormat>())
                            {
                                <option value="@format">@(format == MediaFormat.Cd ? "CD" : format.ToString())</option>
                            }
                        </select>
                    </label>
                }
                    <button type="button" @onclick="ToggleConcertsAsync" aria-pressed="@showConcerts"
                            class="rounded-xl border border-pine-teal-400/60 bg-granite-900 px-4 py-3 font-semibold text-porcelain-50 transition hover:bg-granite-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50">
                        @(showConcerts ? "Show albums" : "Upcoming concerts")
                    </button>
                    @if (AuthSession.CurrentUser is { UserId: > 0 })
                    {
                        <button type="button" @onclick="ToggleSubscriptionAsync" disabled="@subscriptionBusy"
                                class="rounded-xl border border-granite-700 bg-granite-900 px-4 py-3 font-semibold text-porcelain-50 hover:bg-granite-800 disabled:opacity-50">
                            @(subscriptionBusy ? "Please wait…" : isSubscribed ? "Unsubscribe" : "Subscribe to artist")
                        </button>
                        @if (subscriptionMessage is not null)
                        {
                            <p role="status" class="text-sm text-porcelain-50">@subscriptionMessage</p>
                        }
                    }
                </div>
                @if (showConcerts)
                {
                    <div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950 p-6 text-porcelain-50" aria-live="polite" aria-busy="@concertsLoading">
                        <h2 class="text-2xl font-semibold">Upcoming concerts</h2>
                        <p class="text-sm text-porcelain-50/60">@concertLocationMessage</p>
                        @if (concertsLoading)
                        {
                            <p>Loading concerts…</p>
                        }
                        else if (concertError is not null)
                        {
                            <p role="alert">@concertError</p>
                            <button type="button" @onclick="LoadConcertsAsync" class="justify-self-start rounded-xl border border-granite-700 bg-granite-900 px-4 py-2 text-porcelain-50 transition hover:bg-granite-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain-50">Try again</button>
                        }
                        else if (concerts.Count == 0)
                        {
                            <p>No upcoming concerts found@(string.IsNullOrEmpty(concertCountryCode) ? "." : $" in {concertCountryCode}.")</p>
                        }
                        else
                        {
                            @foreach (var concert in concerts)
                            {
                                <article class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6">
                                    <h3 class="text-xl font-semibold">@concert.Name</h3>
                                    <p>@concert.VenueName · @string.Join(", ", new[] { concert.City, concert.Region, concert.CountryCode }.Where(value => !string.IsNullOrWhiteSpace(value)))</p>
                                    <p>@FormatConcertDate(concert)</p>
                                    @if (Uri.TryCreate(concert.Url, UriKind.Absolute, out var url)
                                        && (url.Scheme == Uri.UriSchemeHttps || url.Scheme == Uri.UriSchemeHttp))
                                    {
                                        <a href="@url.AbsoluteUri" target="_blank" rel="noopener noreferrer" class="text-pine-teal-300 underline">View concert / tickets</a>
                                    }
                                </article>
                            }
                        }
                    </div>
                }
                else if (albums.Count == 0)
                {
                    <div
                        class="rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-6 text-center text-porcelain-50/60">
                        No albums found for this artist.
                    </div>
                }
                else
                {
                    <div class="grid gap-6">
                        @foreach (var album in albums)
                        {
                            <div class="rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 overflow-hidden">
                                @* Album header *@
                                <div class="flex items-center gap-5 border-b border-granite-800/60 p-5">
                                    @if (!string.IsNullOrWhiteSpace(album.ImageUrl))
                                    {
                                        <img src="@album.ImageUrl" alt="@album.Title" class="h-16 w-16 rounded-xl object-cover" />
                                    }
                                    else
                                    {
                                        <div
                                            class="flex h-16 w-16 items-center justify-center rounded-xl bg-fiery-terracotta-800/60 text-xs text-porcelain-50/60">
                                            Album
                                        </div>
                                    }
                                    <div class="grid gap-0.5 flex-1 min-w-0">
                                        <a href="@($"/music/album/{album.Id}?fromArtistId={ArtistId}")"
                                           class="text-lg font-semibold text-porcelain-50 transition hover:text-pine-teal-300">@album.Title</a>
                                        <div class="flex flex-wrap gap-3 text-sm text-porcelain-50/50">
                                            @if (!string.IsNullOrWhiteSpace(album.AlbumType))
                                            {
                                                <span class="capitalize">@album.AlbumType</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(album.ReleaseDate))
                                            {
                                                <span>@album.ReleaseDate</span>
                                            }
                                            @if (album.TotalTracks.HasValue)
                                            {
                                                <span>@album.TotalTracks track@(album.TotalTracks == 1 ? "" : "s")</span>
                                            }
                                        </div>
                                    </div>
                                    @if (AuthSession.IsAuthenticated && AuthSession.CurrentUser?.UserId > 0)
                                    {
                                        @if (collectionAlbumIds.Contains(album.Id))
                                        {
                                            <button type="button" @onclick="() => RemoveFromCollectionAsync(album.Id)"
                                                    class="rounded-full border border-pine-teal-400/60 bg-pine-teal-400/10 px-3 py-1.5 text-xs font-semibold text-pine-teal-300 transition hover:bg-fiery-terracotta-950/60 hover:border-fiery-terracotta-400/60 hover:text-fiery-terracotta-300">
                                                ✓ In collection
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => AddToCollectionAsync(album.Id)"
                                                    disabled="@(selectedFormat is null)"
                                                    class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1.5 text-xs font-semibold text-porcelain-50/60 transition hover:border-pine-teal-400/40 hover:text-porcelain-50">
                                                + Collection
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </section>
    }

@code {
    [Parameter]
    public int ArtistId { get; set; }

    private bool isLoading = true;
    private MusicArtist? artist;
    private List<MusicAlbum> albums = [];
    private Dictionary<int, List<MusicTrack>> albumTracks = [];
    private HashSet<int> collectionAlbumIds = [];
    private Dictionary<int, int> collectionEntryIds = [];
    private int loadingTrackAlbumId;
    private MediaFormat? selectedFormat;
    private bool showConcerts;
    private bool concertsLoading;
    private bool concertsLoaded;
    private List<Concert> concerts = [];
    private string concertCountryCode = string.Empty;
    private string concertLocationMessage = string.Empty;
    private string? concertError;
    private bool isSubscribed;
    private bool subscriptionBusy;
    private bool subscriptionStatusLoaded;
    private string? subscriptionMessage;

    /// <summary>
    /// Loads the routed artist's albums and the signed-in user's collection membership.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        showConcerts = false;
        concertsLoaded = false;
        concertsLoading = false;
        concerts = [];
        isSubscribed = false;
        subscriptionStatusLoaded = false;
        subscriptionMessage = null;
        await AuthSession.InitializeAsync();
        artist = null;
        albums = [];
        albumTracks = [];
        collectionAlbumIds = [];
        collectionEntryIds = [];

        var discography = await AuthSession.GetArtistDiscographyAsync(ArtistId);
        artist = discography.Artist;
        albums = discography.Albums.OrderByDescending(a => a.ReleaseDate).ToList();

        if (AuthSession.IsAuthenticated && AuthSession.CurrentUser?.UserId > 0)
        {
            var collection = await AuthSession.GetCollectionAsync(AuthSession.CurrentUser.UserId);
            SetCollection(collection);
            var subscriptions = await SubscriptionApi.GetByUserAsync(AuthSession.CurrentUser);
            subscriptionStatusLoaded = subscriptions is not null;
            isSubscribed = subscriptions?.Any(subscription => subscription.ArtistId == ArtistId) == true;
            if (!subscriptionStatusLoaded)
                subscriptionMessage = "Could not check subscription status. Click to retry.";
        }

        isLoading = false;
    }

    /// <summary>
    /// Subscribes to or unsubscribes from this artist after confirming the current subscription status.
    /// </summary>
    private async Task ToggleSubscriptionAsync()
    {
        if (subscriptionBusy || AuthSession.CurrentUser is not { UserId: > 0 } user) return;
        subscriptionBusy = true;
        subscriptionMessage = null;
        var requestedArtistId = ArtistId;
        try
        {
            // Recover a failed status check before attempting to create a subscription.
            if (!subscriptionStatusLoaded)
            {
                var existing = await SubscriptionApi.GetByUserAsync(user);
                if (ArtistId != requestedArtistId) return;
                if (existing is null)
                {
                    subscriptionMessage = "Could not check subscription status. Please try again.";
                    return;
                }
                subscriptionStatusLoaded = true;
                isSubscribed = existing.Any(subscription => subscription.ArtistId == requestedArtistId);
                if (isSubscribed) return;
            }
            var profile = isSubscribed ? null : await AuthSession.GetForumProfileAsync(user.UserId);
            var country = CountryCodes.FromLocation(profile?.Location) ?? string.Empty;
            var success = isSubscribed
                ? await SubscriptionApi.UnsubscribeAsync(user, requestedArtistId)
                : await SubscriptionApi.SubscribeAsync(user, requestedArtistId, country);
            if (ArtistId != requestedArtistId) return;
            if (success)
            {
                isSubscribed = !isSubscribed;
                subscriptionMessage = isSubscribed ? "Artist subscribed. View their shows on the Concerts page." : "Subscription removed.";
            }
            else subscriptionMessage = "Could not save your subscription. Please try again.";
        }
        finally { subscriptionBusy = false; }
    }

    /// <summary>
    /// Fetch concerts only when the user first opens this view.
    /// </summary>
    private async Task ToggleConcertsAsync()
    {
        showConcerts = !showConcerts;
        if (showConcerts && !concertsLoaded && !concertsLoading)
            await LoadConcertsAsync();
    }

    /// <summary>
    /// Loads upcoming concerts for the selected artist, using the selected or profile country when available.
    /// </summary>
    private async Task LoadConcertsAsync()
    {
        var requestedArtistId = ArtistId;
        concertsLoading = true;
        concertError = null;
        try
        {
            var user = AuthSession.CurrentUser;
            var profile = user is { UserId: > 0 }
                ? await AuthSession.GetForumProfileAsync(user.UserId)
                : null;
            var country = CountryCodes.FromLocation(profile?.Location) ?? string.Empty;
            var results = await ConcertApi.GetByArtistAsync(requestedArtistId, country, user);
            // Ignore responses from an artist the user has navigated away from.
            if (ArtistId != requestedArtistId) return;
            concertCountryCode = country;
            concertLocationMessage = country.Length > 0
                ? $"Showing concerts in {country}, using your profile location."
                : "Showing concerts in all countries because no profile country is available.";
            if (results is null)
                concertError = "Could not load concerts. Please try again.";
            else
            {
                concerts = results.Where(concert => concert.StartsAt >= DateTimeOffset.UtcNow)
                    .OrderBy(concert => concert.StartsAt).ToList();
                concertsLoaded = true;
            }
        }
        catch (Exception)
        {
            if (ArtistId == requestedArtistId)
                concertError = "Could not load concerts. Please try again.";
        }
        finally
        {
            if (ArtistId == requestedArtistId) concertsLoading = false;
        }
    }

    /// <summary>
    /// Formats the concert date in the venue time zone, falling back to the supplied offset.
    /// </summary>
    private static string FormatConcertDate(Concert concert)
    {
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(concert.VenueTimeZone);
            return $"{TimeZoneInfo.ConvertTime(concert.StartsAt, zone):ddd, d MMM yyyy · HH:mm} ({concert.VenueTimeZone})";
        }
        catch (Exception exception) when (exception is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
        {
            return $"{concert.StartsAt:ddd, d MMM yyyy · HH:mm zzz}";
        }
    }

    /// <summary>
    /// Loads and stores an album's tracks while showing its loading indicator.
    /// </summary>
    private async Task LoadTracksAsync(int albumId)
    {
        loadingTrackAlbumId = albumId;
        var tracks = await AuthSession.GetAlbumTracksAsync(albumId);
        albumTracks[albumId] = tracks;
        loadingTrackAlbumId = 0;
    }

    /// <summary>
    /// Adds the selected album and media format, then refreshes collection membership.
    /// </summary>
    private async Task AddToCollectionAsync(int albumId)
    {
        if (AuthSession.CurrentUser?.UserId is not > 0)
        {
            return;
        }

        var ok = await AuthSession.AddToCollectionAsync(AuthSession.CurrentUser.UserId, albumId, format: selectedFormat);
        if (ok)
        {
            ToastService.Show("Album added to collection.");
            SetCollection(await AuthSession.GetCollectionAsync(AuthSession.CurrentUser.UserId));
        }
    }

    /// <summary>
    /// Removes the album's owned entry, then refreshes collection membership.
    /// </summary>
    private async Task RemoveFromCollectionAsync(int albumId)
    {
        if (AuthSession.CurrentUser?.UserId is not > 0)
        {
            return;
        }

        if (!collectionEntryIds.TryGetValue(albumId, out var collectionId))
        {
            return;
        }

        var ok = await AuthSession.RemoveFromCollectionAsync(AuthSession.CurrentUser.UserId, collectionId);
        if (ok)
        {
            ToastService.Show("Album removed from collection.");
            SetCollection(await AuthSession.GetCollectionAsync(AuthSession.CurrentUser.UserId));
        }
    }
    /// <summary>
    /// Keeps the collection entries and owned-album lookup in sync.
    /// </summary>
    private void SetCollection(List<MusicCollectionItem> collection)
    {
        collectionAlbumIds = collection.Select(item => item.AlbumId).ToHashSet();
        collectionEntryIds = collection.GroupBy(item => item.AlbumId).ToDictionary(group => group.Key, group =>
group.First().Id);
    }
}
