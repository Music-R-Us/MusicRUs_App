@page "/"

<PageTitle>Home</PageTitle>


<section class="gradient-surface p-8 lg:p-12">
	<div class="relative grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
		<div>
			<h1 class="max-w-xl text-4xl font-semibold tracking-tight text-porcelain-50 sm:text-5xl">
				Music-R-Us
			</h1>
			<p class="mt-5 max-w-2xl text-base leading-7 text-porcelain-50 sm:text-lg">
				A classic music forum built for music lovers to express their love for music and share their thoughts on the latest albums, concerts, and industry news. Whether you're a casual listener or a die-hard fan, Music-R-Us is the perfect place to connect with other music enthusiasts and stay up-to-date on all things music.
			</p>

		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
			<div class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 p-5 backdrop-blur">
				<p class="text-sm font-medium text-porcelain-50">Music</p>
				<p class="mt-2 text-2xl font-semibold text-porcelain-50">Music is a part of us all</p>
			</div>
			<div class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 p-5 backdrop-blur">
				<p class="text-sm font-medium text-porcelain-50">Community</p>
				<p class="mt-2 text-2xl font-semibold text-porcelain-50">Connect with other music enthusiasts</p>
			</div>
            <div class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 p-5 backdrop-blur">
				<p class="text-sm font-medium text-porcelain-50">Love</p>
				<p class="mt-2 text-2xl font-semibold text-porcelain-50">Express your passion for music</p>
			</div>
		</div>
	</div>
</section>
