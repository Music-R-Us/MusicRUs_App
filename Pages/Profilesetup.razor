@page "/profile/setup"
@page "/profile/setup/{UserId:int}"

@layout MainLayout

@using System.ComponentModel.DataAnnotations
@implements IDisposable

@inject MusicRUs.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation
@inject MusicRUs.Services.ProfileColorService ProfileColors
@inject MusicRUs.Services.ToastService ToastService

<PageTitle>Set up profile</PageTitle>

<section class="mx-auto w-full max-w-4xl">
	<div class="grid gap-8 rounded-4xl border border-granite-800/80 gradient-surface p-8 backdrop-blur">
		<div class="grid gap-3">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-granite-300">Forum profile</p>
			<h1 class="text-4xl font-semibold tracking-tight text-porcelain-50 sm:text-5xl">Set up your profile</h1>
			<p class="max-w-2xl text-base leading-7 text-porcelain-50/80">
				Choose how you show up in the MusicRUs forum.
			</p>
		</div>

		@if (!isReady)
		{
			<div class="rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5 text-porcelain-50/80">
				Loading profile...
			</div>
		}
		else
		{
			@if (!string.IsNullOrWhiteSpace(formMessage))
			{
				<div class="rounded-2xl border border-fiery-terracotta-300/50 bg-fiery-terracotta-950/80 p-4 text-sm font-medium text-porcelain-50">
					@formMessage
				</div>
			}

			<EditForm Model="profileModel" OnValidSubmit="HandleSaveAsync">
				<DataAnnotationsValidator />
				<ValidationSummary class="text-sm text-fiery-terracotta-200" />

				<div class="grid gap-5">
					<div class="grid gap-3">
						<label for="profile-color" class="text-sm font-medium text-porcelain-50">Top bar profile color</label>
						<div class="flex flex-wrap items-center gap-3">
							<input id="profile-color" type="color" value="@SelectedHex" @oninput="PickColor" disabled="@isSaving"
								aria-describedby="profile-color-help" class="h-12 w-16 cursor-pointer rounded-xl border border-granite-800/80 bg-coffee-bean-950/60 p-1 disabled:opacity-60" />
							<label for="profile-color-hex" class="text-sm text-porcelain-50">HEX</label>
							<input id="profile-color-hex" type="text" @bind="selectedColor" @bind:event="oninput"
								pattern="#[0-9a-fA-F]{6}" maxlength="7" required disabled="@isSaving"
								title="Enter # followed by six hexadecimal digits, for example #66706C"
								class="w-32 rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 font-mono text-porcelain-50 outline-none focus:border-fiery-terracotta-300" />
						</div>
						<p id="profile-color-help" class="text-sm text-porcelain-50/70">Choose a color for your name badge in the top bar. Saved in this browser.</p>
						<div class="flex flex-wrap items-center gap-3">
							<span class="rounded-full px-4 py-2 text-sm font-semibold" style="@($"background-color: {SelectedHex}; color: {MusicRUs.Services.ProfileColorService.TextColor(SelectedHex)};")">
								@(string.IsNullOrWhiteSpace(profileModel.DisplayName) ? "Your name" : profileModel.DisplayName)
							</span>
							<button type="button" disabled="@isSaving" @onclick="ResetColor" class="text-sm text-granite-300 underline">Reset color</button>
						</div>
					</div>
					<fieldset class="grid gap-4 rounded-2xl border border-granite-800/80
									bg-coffee-bean-950/60 p-5">
						<legend class="px-2 text-sm font-semibold text-granite-300">
							Profile background
						</legend>

						<div class="grid gap-4 sm:grid-cols-2">
							<div class="grid gap-2">
								<label for="gradient-start"
									class="text-sm font-medium text-porcelain-50">
									Start color
								</label>

								<input id="gradient-start"
									type="color"
									@bind="profileModel.PrimaryColor"
									@bind:event="oninput"
									disabled="@isSaving"
									class="h-12 w-full cursor-pointer rounded-xl border
											border-granite-800 bg-coffee-bean-950 p-1
											focus-visible:outline-2
											focus-visible:outline-granite-300" />
							</div>

							<div class="grid gap-2">
								<label for="gradient-end"
									class="text-sm font-medium text-porcelain-50">
									End color
								</label>

								<input id="gradient-end"
									type="color"
									@bind="profileModel.AccentColor"
									@bind:event="oninput"
									disabled="@isSaving"
									class="h-12 w-full cursor-pointer rounded-xl border
											border-granite-800 bg-coffee-bean-950 p-1
											focus-visible:outline-2
											focus-visible:outline-granite-300" />
							</div>
							<div class="rounded-2xl bg-linear-to-br from-(--profile-start) to-(--profile-end) p-6"style="@GradientPreviewStyle">
								<div class="rounded-xl bg-coffee-bean-950/80 p-4">
									<p class="text-xs font-semibold uppercase tracking-widest
											text-granite-300">
										Preview
									</p>

									<p class="mt-2 text-2xl font-semibold text-porcelain-50">
										@profileModel.DisplayName
									</p>
								</div>
							</div>
						</div>
					</fieldset>
					<div class="grid gap-2 sm:grid-cols-2">
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="display-name">Display name</label>
							<InputText id="display-name" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="profileModel.DisplayName" />
						</div>

						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="location">Location</label>
							<InputText id="location" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="profileModel.Location" />
						</div>
					</div>

					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="bio">Bio</label>
						<InputTextArea id="bio" rows="5" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="profileModel.Bio" />
					</div>

					<div class="grid gap-2 sm:grid-cols-2">
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="avatar-url">Avatar URL</label>
							<InputText id="avatar-url" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="profileModel.AvatarUrl" />
						</div>

						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="favorite-genre">Favorite genre</label>
							<div class="flex gap-2">
								<input id="favorite-genre" class="min-w-0 flex-1 rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind="genreSearch" @bind:event="oninput" />
								<button type="button" @onclick="SetFavoriteGenre" class="self-end rounded-2xl border-2 border-porcelain-50/80 bg-pine-teal-700 px-4 py-4 text-sm font-bold text-porcelain-50 shadow-sm shadow-black/20 transition bg-fiery-terracotta-900/80 hover:border-porcelain-50 hover:bg-pine-teal-600">
									Set Favorite
								</button>
							</div>
						</div>
					</div>

					@if (FilteredGenres.Count > 0 || profileModel.Tags.Count > 0 || !string.IsNullOrWhiteSpace(draftFavoriteGenre))
					{
						<div class="grid gap-3 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-4">
							<div class="flex flex-wrap gap-2">
								@foreach (var genre in FilteredGenres)
								{
								<button type="button" @onclick="() => SelectGenre(genre.Name)" class="rounded-full border-2 border-pine-teal-300/70 bg-granite-900/80 px-3 py-1 text-sm font-semibold text-porcelain-50 shadow-sm shadow-black/20 transition hover:border-pine-teal-200 hover:bg-granite-800">
										@genre.Name
									</button>
								}
							</div>
							<div class="flex flex-wrap gap-2">
								@if (!string.IsNullOrWhiteSpace(draftFavoriteGenre))
								{
									<span class="rounded-full border border-pine-teal-300/70 bg-granite-900/80 px-3 py-1 text-sm font-semibold text-porcelain-50">Favorite: @draftFavoriteGenre</span>
								}
								@foreach (var tag in profileModel.Tags)
								{
									<button type="button" @onclick="() => RemoveGenreTag(tag)" class="rounded-full border border-granite-700 bg-fiery-terracotta-950/70 px-3 py-1 text-sm text-porcelain-50">
										#@tag x
									</button>
								}
							</div>
						</div>
					}


					<div class="grid gap-2">
						<label class="text-sm font-medium text-porcelain-50" for="website-url">Website URL</label>
						<InputText id="website-url" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" @bind-Value="profileModel.WebsiteUrl" />
					</div>

					<div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="artist-search">Favorite artist</label>
							<input id="artist-search" value="@artistSearch" @oninput="OnArtistSearchInputAsync" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" />
						</div>
						@if (isSearchingArtists)
						{
							<p class="text-sm text-porcelain-50/60">Searching...</p>
						}
						@if (artistResults.Count > 0)
						{
							<div class="grid gap-2 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/70 p-3">
								@foreach (var artist in artistResults)
								{
									<button type="button" @onclick="() => SelectArtistResult(artist)" class="flex items-center gap-3 rounded-xl px-3 py-2 text-left text-sm text-porcelain-50 transition hover:bg-granite-900/80">
										@if (!string.IsNullOrWhiteSpace(artist.ImageUrl))
										{
											<img src="@artist.ImageUrl" alt="@artist.Name" class="h-10 w-10 rounded-lg object-cover" />
										}
										<span class="font-semibold">@artist.Name</span>
									</button>
								}
							</div>
						}
						@if (artistResult is not null)
						{
							<div class="flex flex-col gap-3 rounded-2xl border border-granite-800/80 bg-fiery-terracotta-950/70 p-4 sm:flex-row sm:items-center sm:justify-between">
								<div class="flex items-center gap-3">
									@if (!string.IsNullOrWhiteSpace(artistResult.ImageUrl))
									{
										<img src="@artistResult.ImageUrl" alt="@artistResult.Name" class="h-14 w-14 rounded-xl object-cover" />
									}
									<p class="font-semibold text-porcelain-50">@artistResult.Name</p>
								</div>
								<button type="button" @onclick="AddFavoriteArtist" class="rounded-2xl bg-fiery-terracotta-500 px-4 py-2 text-sm font-semibold text-porcelain-50">Add favorite</button>
							</div>
						}
						<div class="flex flex-wrap gap-2">
							@foreach (var artist in profileModel.FavoriteArtists)
							{
								<button type="button" @onclick="() => RemoveFavoriteArtist(artist.Id)" class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50">
									@artist.Name x
								</button>
							}
						</div>
					</div>

					<div class="grid gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-5">
						<div class="grid gap-2">
							<label class="text-sm font-medium text-porcelain-50" for="album-search">Favorite album or collection item</label>
							<input id="album-search" value="@albumSearch" @oninput="OnAlbumSearchInputAsync" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-4 py-3 text-porcelain-50 outline-none transition focus:border-fiery-terracotta-300" />
							<p class="text-sm text-porcelain-50/60">Search by album title or artist name. For missing albums, select the artist above first.</p>
						</div>
						@if (isSearchingAlbums)
						{
							<p class="text-sm text-porcelain-50/60">Searching...</p>
						}
						@if (albumResults.Count > 0)
						{
							<div class="grid gap-2 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/70 p-3">
								@foreach (var album in albumResults)
								{
									<button type="button" @onclick="() => SelectAlbumResult(album)" class="flex items-center gap-3 rounded-xl px-3 py-2 text-left text-sm text-porcelain-50 transition hover:bg-granite-900/80">
										@if (!string.IsNullOrWhiteSpace(album.ImageUrl))
										{
											<img src="@album.ImageUrl" alt="@album.Title" class="h-10 w-10 rounded-lg object-cover" />
										}
										<span>
											<span class="block font-semibold">@album.Title</span>
											@if (!string.IsNullOrWhiteSpace(album.ReleaseDate))
											{
												<span class="text-xs text-porcelain-50/60">@album.ReleaseDate</span>
											}
										</span>
									</button>
								}
							</div>
						}
						@if (albumResult is not null)
						{
							<div class="flex flex-col gap-3 rounded-2xl border border-granite-800/80 bg-fiery-terracotta-950/70 p-4 sm:flex-row sm:items-center sm:justify-between">
								<div class="flex items-center gap-3">
									@if (!string.IsNullOrWhiteSpace(albumResult.ImageUrl))
									{
										<img src="@albumResult.ImageUrl" alt="@albumResult.Title" class="h-14 w-14 rounded-xl object-cover" />
									}
									<div>
										<p class="font-semibold text-porcelain-50">@albumResult.Title</p>
										<p class="text-sm text-porcelain-50/60">@albumResult.ReleaseDate</p>
									</div>
								</div>
								<div class="flex flex-wrap gap-2">
									<button type="button" @onclick="AddFavoriteAlbum" class="rounded-2xl bg-fiery-terracotta-500 px-4 py-2 text-sm font-semibold text-porcelain-50">Add favorite</button>
									<label class="grid gap-1 text-sm text-porcelain-50/80">
										Media format
										<select @bind="selectedCollectionFormat" class="rounded-xl border border-granite-700 bg-coffee-bean-950 px-3 py-2">
											<option value="">Choose format</option>
											@foreach (var format in Enum.GetValues<MediaFormat>())
											{
												<option value="@format">@(format == MediaFormat.Cd ? "CD" : format.ToString())</option>
											}
										</select>
									</label>
									<button type="button" disabled="@(selectedCollectionFormat is null || !collectionLoaded)" @onclick="AddCollectionAlbum" class="rounded-2xl border border-granite-700 bg-granite-900/60 px-4 py-2 text-sm font-semibold text-porcelain-50">Add collection</button>
								</div>
							</div>
						}
						<div class="grid gap-2 sm:grid-cols-2">
							<div class="grid gap-2">
								<p class="text-sm font-semibold uppercase tracking-[0.2em] text-pine-teal-300">Favorite albums</p>
								<div class="flex flex-wrap gap-2">
									@foreach (var album in profileModel.FavoriteAlbums)
									{
										<button type="button" @onclick="() => RemoveFavoriteAlbum(album.Id)" class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50">
											@album.Title x
										</button>
									}
								</div>
							</div>
							<div class="grid gap-2">
								<p class="text-sm font-semibold uppercase tracking-[0.2em] text-pine-teal-300">Music collection</p>
								<div class="flex flex-wrap gap-2">
									@foreach (var album in profileModel.MusicCollection)
									{
										<button type="button" @onclick="() => RemoveCollectionAlbum(album.Id)" class="rounded-full border border-granite-700 bg-granite-900/60 px-3 py-1 text-sm text-porcelain-50">
											@album.Title x
										</button>
									}
								</div>
							</div>
						</div>
					</div>

					<label class="flex items-center gap-4 rounded-2xl border border-granite-800/80 bg-coffee-bean-950/60 p-4 text-sm font-medium text-porcelain-50">
						<InputCheckbox class="h-5 w-5 rounded border-granite-700 bg-fiery-terracotta-900 text-fiery-terracotta-500" @bind-Value="profileModel.IsPublic" />
						<span class="grid gap-1">
							<span>@(profileModel.IsPublic ? "Public profile" : "Private profile")</span>
							<span class="text-xs font-normal text-porcelain-50/60">
								@(profileModel.IsPublic ? "Checked: other members can view your profile." : "Unchecked: your profile stays private.")
							</span>
						</span>
					</label>

					<div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
						<button type="button" @onclick="SkipSetup" class="rounded-2xl border border-granite-800/80 bg-fiery-terracotta-900/80 px-5 py-3 text-base font-semibold text-porcelain-50/80 transition hover:text-porcelain-50">
							Skip for now
						</button>
						<button type="submit" disabled="@isSaving" class="rounded-2xl bg-fiery-terracotta-500 px-5 py-3 text-base font-semibold text-porcelain-50 transition hover:bg-fiery-terracotta-400 disabled:cursor-not-allowed disabled:opacity-60">
							@(isSaving ? "Saving..." : "Save profile")
						</button>
					</div>
				</div>
			</EditForm>
		}
	</div>
</section>

@code {
	[Parameter]
	public int UserId { get; set; }
	private bool isReady;
	private bool isSaving;
	private List<MusicCollectionItem> originalCollection = [];
	private readonly Dictionary<int, MediaFormat> newCollectionFormats = [];
	private MediaFormat? selectedCollectionFormat;
	private bool collectionLoaded;
	private int loadedUserId;
	private string formMessage = string.Empty;
	private string genreSearch = string.Empty;
	private string draftFavoriteGenre = string.Empty;
	private string artistSearch = string.Empty;
	private string albumSearch = string.Empty;
	private List<GenreOption> genres = [];
	private List<MusicArtist> artistResults = [];
	private List<MusicAlbum> albumResults = [];
	private MusicArtist? artistResult;
	private MusicAlbum? albumResult;
	private CancellationTokenSource? artistSearchDebounce;
	private CancellationTokenSource? albumSearchDebounce;
	private bool isSearchingArtists;
	private bool isSearchingAlbums;

	private List<GenreOption> FilteredGenres => genres
		.Where(genre => !string.IsNullOrWhiteSpace(genre.Name))
		.Where(genre => string.IsNullOrWhiteSpace(genreSearch) || genre.Name.Contains(genreSearch, StringComparison.OrdinalIgnoreCase))
		.Take(12)
		.ToList();

	private ProfileSetupModel profileModel = new();
	private string selectedColor = MusicRUs.Services.ProfileColorService.DefaultColor;
	private string SelectedHex => MusicRUs.Services.ProfileColorService.Normalize(selectedColor);
	private static readonly string[] PresetColors = ["#66706C", "#2DD4BF", "#F97316", "#3B82F6", "#A855F7", "#EC4899", "#EAB308", "#FFFFFF"];
	private void ResetColor() => selectedColor = MusicRUs.Services.ProfileColorService.DefaultColor;
	private void PickColor(ChangeEventArgs args) => selectedColor = MusicRUs.Services.ProfileColorService.Normalize(args.Value?.ToString());
	private string GradientPreviewStyle =>
		$"--profile-start: {profileModel.PrimaryColor}; " +
		$"--profile-end: {profileModel.AccentColor};";
	protected override async Task OnParametersSetAsync()
	{
		var initialized = await AuthSession.InitializeAsync();
		if (!initialized)
		{
			return;
		}

		if (!AuthSession.IsAuthenticated || AuthSession.CurrentUser is null)
		{
			Navigation.NavigateTo("/loginpick");
			return;
		}

		var currentUserId = AuthSession.CurrentUser.UserId;
		if (UserId > 0 && UserId != currentUserId)
		{
			Navigation.NavigateTo(GetProfileSetupUrl(currentUserId), replace: true);
			return;
		}

		if (loadedUserId == currentUserId) return;
		loadedUserId = currentUserId;
		var resolvedUserId = currentUserId;
		var profile = await AuthSession.GetForumProfileAsync(resolvedUserId);
		profileModel = ProfileSetupModel.FromProfile(profile, AuthSession.CurrentUser, resolvedUserId);
		originalCollection = await AuthSession.GetCollectionAsync(resolvedUserId);
		collectionLoaded = AuthSession.CollectionError is null;
		if (!collectionLoaded) formMessage = AuthSession.CollectionError!;
		profileModel.MusicCollection = originalCollection.Select(item => item.Album ?? new MusicAlbum { Id = item.AlbumId, Title = item.AlbumTitle }).DistinctBy(album => album.Id).ToList();
		newCollectionFormats.Clear();
		selectedColor = await ProfileColors.GetAsync(resolvedUserId);
		draftFavoriteGenre = profileModel.FavoriteGenre;
		genreSearch = draftFavoriteGenre;
		genres = (await AuthSession.GetGenresAsync()).Concat(profile?.Genres ?? [])
			.Where(genre => genre.Id > 0).DistinctBy(genre => genre.Id).ToList();
		isReady = true;
	}

	private async Task HandleSaveAsync()
	{
		if (isSaving) return;
		if (AuthSession.CurrentUser is null)
		{
			Navigation.NavigateTo("/loginpick");
			return;
		}

		isSaving = true;
		formMessage = string.Empty;

		profileModel.FavoriteGenre = draftFavoriteGenre.Trim();
		// Save the selected search result even when Add favorite was not clicked.
		AddFavoriteArtist();
		var profile = profileModel.ToForumProfile();
		profile.Genres = genres.Where(genre => profileModel.Tags.Contains(genre.Name, StringComparer.OrdinalIgnoreCase)).ToList();
		var saved = await AuthSession.SaveForumProfileAsync(profile);
		if (saved)
		{
			saved = await SaveCollectionChangesAsync();
			if (saved) await ProfileColors.SaveAsync(profileModel.UserId, SelectedHex);
		}
		isSaving = false;

		if (!saved)
		{
			formMessage = AuthSession.CollectionError ?? (string.IsNullOrWhiteSpace(formMessage)
				? "Could not confirm that all profile changes were saved. Your edits are still here. Please try again."
				: formMessage);
			return;
		}
		
		ToastService.Show("Profile saved");

		Navigation.NavigateTo($"/profile/{AuthSession.CurrentUser.UserId}");
	}

	private void SkipSetup()
	{
		if (AuthSession.CurrentUser is null)
		{
			Navigation.NavigateTo("/loginpick");
			return;
		}

		Navigation.NavigateTo($"/profile/{AuthSession.CurrentUser.UserId}");
	}

	private static string GetProfileSetupUrl(int userId)
	{
		return userId > 0
			? $"/profile/setup/{userId}"
			: "/profile/setup";
	}

	private void SelectGenre(string genre)
	{
		genreSearch = genre;
		if (!profileModel.Tags.Contains(genre, StringComparer.OrdinalIgnoreCase))
		{
			profileModel.Tags.Add(genre);
		}
	}

	private void SetFavoriteGenre()
	{
		if (string.IsNullOrWhiteSpace(genreSearch))
		{
			return;
		}

		if (!genres.Any(genre => string.Equals(genre.Name, genreSearch.Trim(), StringComparison.OrdinalIgnoreCase)))
		{
			formMessage = "Choose a genre from the suggestions so it can be saved.";
			return;
		}

		draftFavoriteGenre = genreSearch.Trim();
		if (!profileModel.Tags.Contains(draftFavoriteGenre, StringComparer.OrdinalIgnoreCase))
		{
			profileModel.Tags.Add(draftFavoriteGenre);
		}
	}

	private void RemoveGenreTag(string tag)
	{
		profileModel.Tags.RemoveAll(existing => string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase));
		if (string.Equals(draftFavoriteGenre, tag, StringComparison.OrdinalIgnoreCase)) draftFavoriteGenre = string.Empty;
	}

	private async Task OnArtistSearchInputAsync(ChangeEventArgs args)
	{
		artistSearch = args.Value?.ToString() ?? string.Empty;
		artistResult = null;
		artistResults = [];
		await DebounceArtistSearchAsync();
	}

	private async Task DebounceArtistSearchAsync()
	{
		CancelArtistSearchDebounce();

		if (artistSearch.Trim().Length < 2)
		{
			isSearchingArtists = false;
			return;
		}

		var debounce = new CancellationTokenSource();
		artistSearchDebounce = debounce;
		isSearchingArtists = true;
		formMessage = string.Empty;
		await InvokeAsync(StateHasChanged);

		try
		{
			await Task.Delay(TimeSpan.FromMilliseconds(400), debounce.Token);
			var results = await AuthSession.SearchArtistsAsync(artistSearch, debounce.Token);
			if (!debounce.IsCancellationRequested && ReferenceEquals(artistSearchDebounce, debounce))
			{
				artistResults = results;
			}
		}
		catch (OperationCanceledException)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(artistSearchDebounce, debounce))
			{
				artistSearchDebounce = null;
				isSearchingArtists = false;
				await InvokeAsync(StateHasChanged);
			}
			debounce.Dispose();
		}
	}

	private void SelectArtistResult(MusicArtist artist)
	{
		CancelArtistSearchDebounce();
		isSearchingArtists = false;
		artistResult = artist;
		artistSearch = artist.Name;
		artistResults = [];
		formMessage = string.Empty;
	}

	private void AddFavoriteArtist()
	{
		if (artistResult is null || artistResult.Id <= 0 || profileModel.FavoriteArtists.Any(artist => artist.Id == artistResult.Id))
		{
			return;
		}

		profileModel.FavoriteArtists.Add(artistResult);
		artistResult = null;
		artistSearch = string.Empty;
	}

	private void RemoveFavoriteArtist(int artistId)
	{
		profileModel.FavoriteArtists.RemoveAll(artist => artist.Id == artistId);
		if (artistResult?.Id == artistId)
		{
			artistResult = null;
			artistSearch = string.Empty;
		}
	}

	private async Task OnAlbumSearchInputAsync(ChangeEventArgs args)
	{
		albumSearch = args.Value?.ToString() ?? string.Empty;
		albumResult = null;
		albumResults = [];
		await DebounceAlbumSearchAsync();
	}

	private async Task DebounceAlbumSearchAsync()
	{
		CancelAlbumSearchDebounce();

		if (albumSearch.Trim().Length < 2)
		{
			isSearchingAlbums = false;
			return;
		}

		var debounce = new CancellationTokenSource();
		albumSearchDebounce = debounce;
		isSearchingAlbums = true;
		formMessage = string.Empty;
		await InvokeAsync(StateHasChanged);

		try
		{
			await Task.Delay(TimeSpan.FromMilliseconds(400), debounce.Token);
			var query = albumSearch.Trim();
			var results = await AuthSession.SearchAlbumsAsync(query, debounce.Token);
			debounce.Token.ThrowIfCancellationRequested();
			if (results.Count == 0)
			{
				// New artists may exist before their albums have been imported.
				var artists = profileModel.FavoriteArtists.ToList();
				if (artistResult is not null) artists.Add(artistResult);
				var matchingArtists = await AuthSession.SearchArtistsAsync(query, debounce.Token);
				debounce.Token.ThrowIfCancellationRequested();
				artists.AddRange(matchingArtists.Where(artist =>
					string.Equals(artist.Name.Trim(), query, StringComparison.OrdinalIgnoreCase)));
				var importedAlbums = new List<MusicAlbum>();
				foreach (var artist in artists.Where(artist => artist.Id > 0).DistinctBy(artist => artist.Id))
				{
					debounce.Token.ThrowIfCancellationRequested();
					var discography = await AuthSession.GetArtistDiscographyAsync(artist.Id, debounce.Token);
					importedAlbums.AddRange(discography.Albums.Where(album =>
						album.Title.Contains(query, StringComparison.OrdinalIgnoreCase) ||
						string.Equals(artist.Name.Trim(), query, StringComparison.OrdinalIgnoreCase)));
				}
				debounce.Token.ThrowIfCancellationRequested();
				if (artists.Count > 0)
				{
					results = (await AuthSession.SearchAlbumsAsync(query, debounce.Token))
						.Concat(importedAlbums).DistinctBy(album => album.Id).ToList();
				}
			}
			if (!debounce.IsCancellationRequested && ReferenceEquals(albumSearchDebounce, debounce))
			{
				albumResults = results;
				if (results.Count == 0)
				{
					formMessage = "No albums found. Try searching by artist name, or select the artist above and search the album title again.";
				}
			}
		}
		catch (OperationCanceledException)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(albumSearchDebounce, debounce))
			{
				albumSearchDebounce = null;
				isSearchingAlbums = false;
				await InvokeAsync(StateHasChanged);
			}
			debounce.Dispose();
		}
	}

	private void SelectAlbumResult(MusicAlbum album)
	{
		CancelAlbumSearchDebounce();
		isSearchingAlbums = false;
		albumResult = album;
		albumSearch = album.Title;
		albumResults = [];
		formMessage = string.Empty;
	}

	private void AddFavoriteAlbum()
	{
		if (albumResult is null || albumResult.Id <= 0 || profileModel.FavoriteAlbums.Any(album => album.Id == albumResult.Id))
		{
			return;
		}

		profileModel.FavoriteAlbums.Add(albumResult);
	}

	private void RemoveFavoriteAlbum(int albumId)
	{
		profileModel.FavoriteAlbums.RemoveAll(album => album.Id == albumId);
	}

	private void AddCollectionAlbum()
	{
		if (selectedCollectionFormat is null || !collectionLoaded || albumResult is null || profileModel.MusicCollection.Any(album => album.Id == albumResult.Id))
		{
			return;
		}

		profileModel.MusicCollection.Add(albumResult);
		newCollectionFormats[albumResult.Id] = selectedCollectionFormat.Value;
	}

	private void RemoveCollectionAlbum(int albumId)
	{
		profileModel.MusicCollection.RemoveAll(album => album.Id == albumId);
		newCollectionFormats.Remove(albumId);
	}

	private async Task<bool> SaveCollectionChangesAsync()
	{
		if (!collectionLoaded)
		{
			formMessage = "Reload this page before editing the collection; it could not be loaded.";
			return false;
		}
		return await AuthSession.SaveCollectionChangesAsync(profileModel.UserId, originalCollection,
			profileModel.MusicCollection, newCollectionFormats);
	}

	private sealed class ProfileSetupModel
	{
		public int Id { get; set; }

		public int UserId { get; set; }

		[Required]
		public string DisplayName { get; set; } = string.Empty;

		public string Bio { get; set; } = string.Empty;

		[Url]
		public string AvatarUrl { get; set; } = string.Empty;

		public string Location { get; set; } = string.Empty;


		public string FavoriteGenre { get; set; } = string.Empty;

		public List<string> Tags { get; set; } = [];
		public List<MusicArtist> FavoriteArtists { get; set; } = [];
		public List<MusicAlbum> FavoriteAlbums { get; set; } = [];
		public List<MusicAlbum> MusicCollection { get; set; } = [];

		public string WebsiteUrl { get; set; } = string.Empty;

		public bool IsPublic { get; set; } = true;
		
		[Required]
		[RegularExpression("^#[0-9a-fA-F]{6}$")]
		public string PrimaryColor { get; set; } = "#2E0B05";

		[Required]
		[RegularExpression("^#[0-9a-fA-F]{6}$")]
		public string AccentColor { get; set; } = "#B82A14";

		public DateTimeOffset CreatedAt { get; set; } = DateTimeOffset.UtcNow;

		public DateTimeOffset UpdatedAt { get; set; } = DateTimeOffset.UtcNow;

		public static ProfileSetupModel FromProfile(ForumProfile? profile, UserSession user, int userId)
		{
			return new ProfileSetupModel
			{
				Id = profile?.Id ?? 0,
				UserId = profile?.UserId > 0 ? profile.UserId : userId,
				DisplayName = string.IsNullOrWhiteSpace(profile?.DisplayName) ? user.DisplayName : profile.DisplayName,
				Bio = profile?.Bio ?? string.Empty,
				AvatarUrl = string.IsNullOrWhiteSpace(profile?.AvatarUrl) ? user.AvatarUrl : profile.AvatarUrl,
				Location = profile?.Location ?? string.Empty,
				FavoriteGenre = profile?.FavoriteGenre ?? string.Empty,
				Tags = profile?.Genres is { Count: > 0 }
					? profile.Genres.Select(genre => genre.Name).ToList()
					: profile?.Tags?.ToList() ?? [],
				FavoriteArtists = profile?.FavoriteArtists?.ToList() ?? [],
				FavoriteAlbums = profile?.FavoriteAlbums?.ToList() ?? [],
				MusicCollection = profile?.MusicCollection?.ToList() ?? [],
				WebsiteUrl = profile?.WebsiteUrl ?? string.Empty,
				IsPublic = profile?.IsPublic ?? true,
				PrimaryColor = profile?.PrimaryColor ?? "#2E0B05",
				AccentColor = profile?.AccentColor ?? "#B82A14",
				CreatedAt = profile?.CreatedAt ?? DateTimeOffset.UtcNow,
				UpdatedAt = profile?.UpdatedAt ?? DateTimeOffset.UtcNow
			};
		}

		public ForumProfile ToForumProfile()
		{
			return new ForumProfile
			{
				Id = Id,
				UserId = UserId,
				DisplayName = DisplayName.Trim(),
				Bio = Bio.Trim(),
				AvatarUrl = AvatarUrl.Trim(),
				Location = Location.Trim(),
				FavoriteGenre = FavoriteGenre.Trim(),
				Tags = Tags.Where(tag => !string.IsNullOrWhiteSpace(tag)).Distinct(StringComparer.OrdinalIgnoreCase).ToList(),
				FavoriteArtists = FavoriteArtists.ToList(),
				FavoriteAlbums = FavoriteAlbums.ToList(),
				MusicCollection = MusicCollection.ToList(),
				WebsiteUrl = WebsiteUrl.Trim(),
				IsPublic = IsPublic,
				PrimaryColor = PrimaryColor,
				AccentColor = AccentColor,
				CreatedAt = CreatedAt,
				UpdatedAt = DateTimeOffset.UtcNow
			};
		}
	}

	public void Dispose()
	{
		CancelArtistSearchDebounce();
		CancelAlbumSearchDebounce();
	}

	private void CancelArtistSearchDebounce()
	{
		var debounce = artistSearchDebounce;
		artistSearchDebounce = null;
		if (debounce is null)
		{
			return;
		}

		try
		{
			debounce.Cancel();
		}
		catch (ObjectDisposedException)
		{
		}

	}

	private void CancelAlbumSearchDebounce()
	{
		var debounce = albumSearchDebounce;
		albumSearchDebounce = null;
		if (debounce is null)
		{
			return;
		}

		try
		{
			debounce.Cancel();
		}
		catch (ObjectDisposedException)
		{
		}

	}
}
